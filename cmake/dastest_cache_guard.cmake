cmake_minimum_required(VERSION 3.12)
file(STRINGS "${NEW}" _new)
set(_old "")
if(EXISTS "${DIR}/binary_identity.txt")
    file(STRINGS "${DIR}/binary_identity.txt" _old)
endif()
if(ENABLED AND _old STREQUAL _new)
    message(STATUS "dastest result cache: kept")
    return()
endif()
foreach(_line IN LISTS _new)
    if(NOT _line IN_LIST _old)
        message(STATUS "dastest result cache: changed ${_line}")
    endif()
endforeach()
message(STATUS "dastest result cache: dropped")
file(REMOVE_RECURSE "${DIR}")
