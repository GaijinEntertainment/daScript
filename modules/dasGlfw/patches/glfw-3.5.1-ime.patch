+static int utf8OffsetToCodepointIndex(const char* text, int32_t offset)
+{
+    const char* cur = text;
+    const char* end;
+    int index = 0;
+
+    if (!text || offset <= 0)
+        return 0;
+
+    end = text + offset;
+    while (*cur && cur < end)
+    {
+        _glfwDecodeUTF8(&cur);
+        index++;
+    }
+
+    return index;
+}
