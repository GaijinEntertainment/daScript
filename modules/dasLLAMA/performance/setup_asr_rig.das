options gen2
options stack = 524288   // every dasLLAMA program root takes this budget (options stack does not unify up from libs)

require profile_common
require dasllama/dasllama_env
require daslib/clargs
require daslib/fio
require strings
require math

// Builds the ASR half of the profiling rig on a fresh box, so a remote session produces the
// audio board without laptop-local knowledge. Legs (combine freely; --check verifies them all):
//   --corpus  the 5 bench clips: jfk/gb1 copied from $WHISPER_CPP/samples, hp0 fetched from
//             wikimedia + converted, jfk3/hp0x2 regenerated by concatenation. Verified against
//             benchmarks/asr/corpus.sha256.
//   --libri   the 25-clip LibriSpeech dictation set (test-clean 1089-134686-0000..0024, OpenSLR
//             SLR12) — fetched, converted to 16 kHz mono wav. Parakeet-v3 scope only.
//   --refs    reference engines: whisper.cpp (whisper-cli + parakeet-cli) at the pinned commit,
//             llama.cpp at the pinned commit + patches/mtmd-timing.patch, CPU-only mtmd build.
//   --venvs   the onnx / nemo python environments from requirements-{onnx,nemo}.txt.
//   --check   verify every input and tool, print the env lines a sweep needs.
//   bin/daslang modules/dasLLAMA/performance/setup_asr_rig.das -- --corpus --check

// The pinned reference commits — the identity the version capture expects (B4). Bumping either
// is a deliberate re-baseline: re-run the sweeps after.
let WHISPER_CPP_COMMIT = "6fc7c33b4"
let LLAMA_CPP_COMMIT = "ebd048fc5"
let LIBRI_URL = "https://www.openslr.org/resources/12/test-clean.tar.gz"
let HP0_URL = "https://upload.wikimedia.org/wikipedia/en/d/d4/En.henryfphillips.ogg"
let GB1_URL = "https://upload.wikimedia.org/wikipedia/commons/1/1f/George_W_Bush_Columbia_FINAL.ogg"

[CommandLineArgs]
struct Args {
    @clarg_doc = "Fetch/regenerate the 5 corpus clips + verify the sha manifest"
    corpus : bool

    @clarg_doc = "Fetch + convert the 25-clip LibriSpeech dictation set"
    libri : bool

    @clarg_doc = "Clone + build the reference engines (whisper.cpp, patched mtmd)"
    refs : bool

    @clarg_doc = "Create the onnx/nemo python venvs from the committed requirements"
    venvs : bool

    @clarg_doc = "Verify every rig input and print the env lines a sweep needs"
    check : bool

    @clarg_name = "refs-root"
    @clarg_doc = "Where --refs clones the reference checkouts (default: the directory above the repo)"
    refs_root : string = ".."

    @clarg_short = "?"
    @clarg_doc = "Show this help and exit"
    help : bool
}

def private run_step(what, cmd : string) : bool {
    to_log(LOG_INFO, "setup_asr_rig: {what}\n")
    let out = run_capture("{cmd} 2>&1", false)
    let rc_line = run_capture("echo $?", true)   // popen swallows the status; re-probe cheaply
    if (find(out, "fatal:") >= 0 || find(out, "error:") >= 0 || find(out, "Error") >= 0) {
        to_log(LOG_ERROR, "setup_asr_rig: {what} FAILED — tail: {slice(out, max(0, length(out) - 400))}\n")
        return false
    }
    return !empty(rc_line) || true
}

// ===== corpus =====

// one manifest row: "sha256  name"
def private read_manifest() : array<tuple<sha : string; name : string>> {
    var out : array<tuple<sha : string; name : string>>
    let text = fread("{asr_dir()}/corpus.sha256")
    for (line in split(text, "\n")) {
        let s = strip(line)
        if (empty(s)) {
            continue
        }
        var toks <- [for (tk in split(s, " ")); tk; where !empty(tk)]
        if (length(toks) == 2) {
            out |> push((sha = toks[0], name = toks[1]))
        }
        delete toks
    }
    return <- out
}

def private verify_manifest() : bool {
    var ok = true
    var rows <- read_manifest()
    if (empty(rows)) {
        to_log(LOG_ERROR, "setup_asr_rig: manifest {asr_dir()}/corpus.sha256 missing or empty\n")
        return false
    }
    for (row in rows) {
        let fi = file_identity("{asr_corpus_dir()}{row.name}", "clip")
        if (empty(fi.sha256)) {
            to_log(LOG_ERROR, "setup_asr_rig: corpus {row.name} — MISSING\n")
            ok = false
        } elif (fi.sha256 != row.sha) {
            to_log(LOG_ERROR, "setup_asr_rig: corpus {row.name} — sha MISMATCH (have {slice(fi.sha256, 0, 12)}…, manifest {slice(row.sha, 0, 12)}…) — different bytes would silently bench a different input\n")
            ok = false
        } else {
            to_log(LOG_INFO, "setup_asr_rig: corpus {row.name} — ok\n")
        }
    }
    delete rows
    return ok
}

// WAV concat for identical-format PCM files: first file's header, data chunks appended, RIFF and
// data sizes patched. Deterministic — no decoder in the path, so the manifest holds across boxes.
def private concat_wav(src : string; times : int; dst : string) : bool {
    var bytes : array<uint8>
    let src_sz = int64(stat(src).size)
    fopen(src, "rb") $(f) {
        if (f != null) {
            fload(f, src_sz) $(data) {
                bytes := data
            }
        }
    }
    if (length(bytes) < 44) {
        to_log(LOG_ERROR, "setup_asr_rig: {src} — not a wav\n")
        return false
    }
    // locate the data chunk (after fmt and any LIST/INFO chunks)
    var pos = 12
    var data_off = -1
    var data_len = 0
    while (pos + 8 <= length(bytes)) {
        let id = "{to_char(int(bytes[pos]))}{to_char(int(bytes[pos + 1]))}{to_char(int(bytes[pos + 2]))}{to_char(int(bytes[pos + 3]))}"
        let sz = int(bytes[pos + 4]) | (int(bytes[pos + 5]) << 8) | (int(bytes[pos + 6]) << 16) | (int(bytes[pos + 7]) << 24)
        if (id == "data") {
            data_off = pos + 8
            data_len = sz
            break
        }
        pos += 8 + sz + (sz & 1)
    }
    if (data_off < 0) {
        to_log(LOG_ERROR, "setup_asr_rig: {src} — no data chunk\n")
        return false
    }
    let total_data = data_len * times
    var out : array<uint8>
    out |> reserve(data_off + total_data)
    for (i in range(data_off)) {
        out |> push(bytes[i])
    }
    for (_t in range(times)) {
        for (i in range(data_len)) {
            out |> push(bytes[data_off + i])
        }
    }
    // patch RIFF size (bytes 4..7 = filesize-8) and the data chunk size
    let riff_sz = length(out) - 8
    for (i in range(4)) {
        out[4 + i] = uint8((riff_sz >> (8 * i)) & 0xFF)
        out[data_off - 4 + i] = uint8((total_data >> (8 * i)) & 0xFF)
    }
    var wrote = false
    fopen(dst, "wb") $(f) {
        if (f != null) {
            fwrite(f, out)
            wrote = true
        }
    }
    delete bytes
    delete out
    return wrote
}

def private fetch_ogg_as_wav(url, tmp_name, dst : string) {
    let ogg = "{asr_corpus_dir()}{tmp_name}"
    run_capture("curl -sL -o \"{ogg}\" {url}", false)
    run_capture("ffmpeg -y -loglevel error -i \"{ogg}\" -ar 16000 -ac 1 -c:a pcm_s16le \"{dst}\"", false)
    remove(ogg)
}

def private setup_corpus() : bool {
    mkdir_rec(asr_corpus_dir())
    let samples = "{whisper_cpp_root()}/samples"
    // jfk ships inside the whisper.cpp checkout the rig needs anyway; gb1 only ever existed there
    // via `make samples`, so prefer a checkout copy (byte-identical to the manifest source) and
    // fall back to the same wikimedia fetch+convert the Makefile's samples target encodes
    for (name in ["jfk.wav", "gb1.wav"]) {
        let dst = "{asr_corpus_dir()}{name}"
        if (!stat(dst).is_valid) {
            let src = normalize("{samples}/{name}")
            if (stat(src).is_valid) {
                run_capture(is_windows_box() ? "copy \"{src}\" \"{dst}\"" : "cp \"{src}\" \"{dst}\"", false)
            } elif (name == "gb1.wav") {
                fetch_ogg_as_wav(GB1_URL, "_gb1.ogg", dst)
            } else {
                to_log(LOG_ERROR, "setup_asr_rig: {src} missing — clone/checkout whisper.cpp first (--refs)\n")
                return false
            }
        }
    }
    // hp0: wikimedia ogg → 16 kHz mono pcm16 wav (ffmpeg). Decode determinism is verified by the
    // manifest — if this box's ffmpeg produces different bytes, copy hp0.wav from a manifest-clean
    // box instead (BRINGUP.md).
    let hp0 = "{asr_corpus_dir()}hp0.wav"
    if (!stat(hp0).is_valid) {
        fetch_ogg_as_wav(HP0_URL, "_hp0.ogg", hp0)
    }
    // the two long-form fixtures are concatenations of the above — regenerated, never fetched
    if (!stat("{asr_corpus_dir()}jfk3.wav").is_valid) {
        if (!concat_wav("{asr_corpus_dir()}jfk.wav", 3, "{asr_corpus_dir()}jfk3.wav")) {
            return false
        }
    }
    if (!stat("{asr_corpus_dir()}hp0x2.wav").is_valid) {
        if (!concat_wav(hp0, 2, "{asr_corpus_dir()}hp0x2.wav")) {
            return false
        }
    }
    return verify_manifest()
}

// ===== libri =====

def private setup_libri() : bool {
    let dir = "{asr_corpus_dir()}librispeech/"
    mkdir_rec(dir)
    var have = 0
    dir(dir) $(fn) {
        if (ends_with(fn, ".wav")) {
            have++
        }
    }
    if (have >= 25) {
        to_log(LOG_INFO, "setup_asr_rig: librispeech — {have} clip(s) already present\n")
        return true
    }
    to_log(LOG_INFO, "setup_asr_rig: fetching LibriSpeech test-clean (346 MB, one-time)\n")
    let tarball = "{asr_corpus_dir()}_test-clean.tar.gz"
    run_capture("curl -sL -o \"{tarball}\" {LIBRI_URL}", false)
    if (!stat(tarball).is_valid) {
        to_log(LOG_ERROR, "setup_asr_rig: LibriSpeech download failed\n")
        return false
    }
    // extract only the one chapter the rig uses
    run_capture("tar -xzf \"{tarball}\" -C \"{asr_corpus_dir()}\" LibriSpeech/test-clean/1089/134686", false)
    for (i in range(25)) {
        let nn = i + 1 < 10 ? "0{i + 1}" : "{i + 1}"
        let utt = i < 10 ? "000{i}" : "00{i}"
        let flac = "{asr_corpus_dir()}LibriSpeech/test-clean/1089/134686/1089-134686-{utt}.flac"
        let wav = "{dir}{nn}_1089-134686-{utt}.wav"
        if (!stat(wav).is_valid) {
            run_capture("ffmpeg -y -loglevel error -i \"{flac}\" -ar 16000 -ac 1 -c:a pcm_s16le \"{wav}\"", false)
        }
        if (!stat(wav).is_valid) {
            to_log(LOG_ERROR, "setup_asr_rig: libri clip {wav} failed to convert\n")
            return false
        }
    }
    remove(tarball)
    run_capture("rm -rf \"{asr_corpus_dir()}LibriSpeech\"", false)
    to_log(LOG_INFO, "setup_asr_rig: librispeech — 25 clip(s) ready\n")
    return true
}

// ===== refs + venvs =====

def private setup_refs(cfg : Args) : bool {
    var ok = true
    // whisper.cpp (carries whisper-cli AND parakeet-cli upstream)
    let wroot = whisper_cpp_root()
    if (!stat(normalize("{wroot}/CMakeLists.txt")).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: cloning whisper.cpp @ {WHISPER_CPP_COMMIT}\n")
        run_capture("git clone https://github.com/ggml-org/whisper.cpp.git \"{wroot}\"", false)
    }
    run_capture("git -C \"{wroot}\" fetch -q origin && git -C \"{wroot}\" checkout -q {WHISPER_CPP_COMMIT}", false)
    if (!stat(whisper_cpp_bin("whisper-cli")).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: building whisper.cpp (whisper-cli + parakeet-cli)\n")
        run_capture("cmake -S \"{wroot}\" -B \"{wroot}/build\" -DCMAKE_BUILD_TYPE=Release && cmake --build \"{wroot}/build\" --config Release -j 8", false)
    }
    ok = ok && stat(whisper_cpp_bin("whisper-cli")).is_valid && stat(whisper_cpp_bin("parakeet-cli")).is_valid
    // the q8_0 reference siblings the catalog's cli refs time (upstream quantize tools;
    // idempotent — a present sibling is never rebuilt)
    for (pair in [(quant = "whisper-quantize", src = "ggml-tiny.bin", dst = "ggml-tiny-q8_0.bin"),
                  (quant = "whisper-quantize", src = "ggml-large-v3-turbo.bin", dst = "ggml-large-v3-turbo-q8_0.bin"),
                  (quant = "parakeet-quantize", src = "ggml-parakeet-tdt-0.6b-v2-f32.bin", dst = "ggml-parakeet-tdt-0.6b-v2-q8_0.bin"),
                  (quant = "parakeet-quantize", src = "ggml-parakeet-tdt-0.6b-v3-f32.bin", dst = "ggml-parakeet-tdt-0.6b-v3-q8_0.bin")]) {
        let src_path = "{whisper_models_dir()}{pair.src}"
        let dst_path = "{whisper_models_dir()}{pair.dst}"
        if (stat(src_path).is_valid && !stat(dst_path).is_valid) {
            to_log(LOG_INFO, "setup_asr_rig: quantizing {pair.src} -> {pair.dst} (q8_0)\n")
            // `call ` so the line never STARTS with a quote — cmd.exe strips a leading one
            // and mangles the rest (the daspkg release_tuner_cmd rule, hit live on zen2)
            let lead = is_windows_box() ? "call " : ""
            run_capture("{lead}\"{whisper_cpp_bin(pair.quant)}\" \"{src_path}\" \"{dst_path}\" q8_0", false)
            if (!stat(dst_path).is_valid) {
                to_log(LOG_WARNING, "setup_asr_rig: q8_0 sibling {pair.dst} did not materialize — the {pair.quant} run failed\n")
                ok = false
            }
        }
    }
    // patched CPU-only mtmd
    let lroot = normalize("{cfg.refs_root}/llama.cpp-mtmd-ref")
    if (!stat(mtmd_bin()).is_valid) {
        if (!stat(normalize("{lroot}/CMakeLists.txt")).is_valid) {
            to_log(LOG_INFO, "setup_asr_rig: cloning llama.cpp @ {LLAMA_CPP_COMMIT} for the mtmd reference\n")
            run_capture("git clone https://github.com/ggml-org/llama.cpp.git \"{lroot}\"", false)
        }
        run_capture("git -C \"{lroot}\" fetch -q origin && git -C \"{lroot}\" checkout -q {LLAMA_CPP_COMMIT}", false)
        let patch = get_full_file_name("{asr_dir()}/patches/mtmd-timing.patch")
        run_capture("git -C \"{lroot}\" apply \"{patch}\"", false)
        to_log(LOG_INFO, "setup_asr_rig: building llama-mtmd-cli (CPU-only: Metal OFF)\n")
        run_capture("cmake -S \"{lroot}\" -B \"{lroot}/build-cpu\" -DCMAKE_BUILD_TYPE=Release -DGGML_METAL=OFF && cmake --build \"{lroot}/build-cpu\" --config Release -j 8 --target llama-mtmd-cli", false)
        to_log(LOG_INFO, "setup_asr_rig: set MTMD_BIN={lroot}/build-cpu/bin/llama-mtmd-cli\n")
    }
    return ok
}

def private probe_python_version(cand : string) : int {
    return to_int(strip(run_capture("{cand} -c \"import sys; print(sys.version_info.major * 100 + sys.version_info.minor)\" 2>&1", true)))
}

// the base interpreter: POSIX ships `python3`, Windows ships `python` (and a Store-alias stub
// that answers `python3` with an install nag) — probe in order. The pins were frozen on
// CPython 3.11 and 3.13 breaks them (the numpy pin has no cp313 wheel — pip falls into a
// Meson source build), so only 3.10-3.12 qualifies; a uv-managed interpreter is the fallback
// when every PATH python is outside the range.
def private base_python() : string {
    let pinned = normalize(env_str("DASLLAMA_BASE_PYTHON", ""))
    if (!empty(pinned)) {
        let pv = probe_python_version(pinned)
        if (pv >= 310 && pv < 313) {
            return pinned
        }
        to_log(LOG_WARNING, "setup_asr_rig: DASLLAMA_BASE_PYTHON={pinned} probes as {pv} — outside 3.10-3.12, ignoring\n")
    }
    for (cand in ["python3.11", "python3.10", "python3.12", "python3", "python"]) {
        let v = probe_python_version(cand)
        if (v >= 310 && v < 313) {
            return cand
        }
    }
    for (ver in ["3.11", "3.10", "3.12"]) {
        let p = normalize(strip(run_capture("uv python find {ver} 2>&1", true)))
        if (stat(p).is_valid && probe_python_version(p) >= 310) {
            return p
        }
    }
    return ""
}

def private setup_venvs() : bool {
    // the pins in requirements-*.txt were frozen on CPython 3.11 — an older interpreter dies
    // five screens deep in pip resolution, so gate LOUDLY first. No-admin install route (a
    // fresh mac's CLT python is 3.9): `curl -LsSf https://astral.sh/uv/install.sh | sh`,
    // `uv python install 3.11`, put its bin dir first on PATH.
    let basepy = base_python()
    if (empty(basepy)) {
        to_log(LOG_ERROR, "setup_asr_rig: no CPython 3.10-3.12 found (PATH names or uv) — the venv pins were frozen on 3.11 and 3.13+ breaks them; `uv python install 3.11` (uv route above) and re-run\n")
        return false
    }
    var ok = true
    for (spec in [(name = "onnx", py = onnx_py()), (name = "nemo", py = nemo_py())]) {
        // present = the interpreter exists AND the pinned packages import — a half-made venv
        // (pip died mid-install) leaves the interpreter behind and must be rebuilt, not skipped
        if (stat(spec.py).is_valid && venv_ready(spec.name, spec.py)) {
            to_log(LOG_INFO, "setup_asr_rig: {spec.name} venv — present\n")
            continue
        }
        let venv = normalize("{asr_dir()}/.venv-{spec.name}")
        if (stat(venv).is_valid) {
            to_log(LOG_WARNING, "setup_asr_rig: {spec.name} venv at {venv} is half-made — rebuilding\n")
            run_capture("rm -rf \"{venv}\"", false)
        }
        to_log(LOG_INFO, "setup_asr_rig: creating {spec.name} venv at {venv} (base: {basepy})\n")
        run_capture("{basepy} -m venv {venv}", false)
        let py = venv_python(venv)
        let req = normalize("{asr_dir()}/requirements-{spec.name}.txt")
        run_capture("{py} -m pip -q install -r {req}", false)
        // gate on the PACKAGES importing, not the interpreter existing — pip dying after
        // `python -m venv` succeeded leaves a stat-able python.exe over an empty site-packages
        if (stat(py).is_valid && venv_ready(spec.name, py)) {
            to_log(LOG_INFO, "setup_asr_rig: set {spec.name == "onnx" ? "ONNX_PY" : "NEMO_PY"}={py}\n")
        } else {
            to_log(LOG_ERROR, "setup_asr_rig: {spec.name} venv creation failed\n")
            ok = false
        }
    }
    return ok
}

def private venv_ready(name, py : string) : bool {
    let devnull = is_windows_box() ? "2>nul" : "2>/dev/null"
    let probe = run_capture("{py} -c \"import {name == "onnx" ? "onnx_asr" : "nemo"}; print(1)\" {devnull}", true)
    return to_int(strip(probe)) == 1
}

// ===== check =====

def private check_all() : bool {
    var ok = verify_manifest()
    for (tool in ["whisper-cli", "parakeet-cli"]) {
        let bin = whisper_cpp_bin(tool)
        let good = stat(bin).is_valid
        to_log(good ? LOG_INFO : LOG_ERROR, "setup_asr_rig: {tool} — {good ? "ok" : "MISSING"} ({bin})\n")
        ok = ok && good
    }
    let versions = whisper_cpp_versions()
    to_log(LOG_INFO, "setup_asr_rig: {empty(versions) ? "whisper.cpp checkout not identified" : versions}\n")
    ok = ok && find(versions, "+dirty") < 0
    for (dst in ["ggml-tiny-q8_0.bin", "ggml-large-v3-turbo-q8_0.bin",
                 "ggml-parakeet-tdt-0.6b-v2-q8_0.bin", "ggml-parakeet-tdt-0.6b-v3-q8_0.bin"]) {
        let present = stat("{whisper_models_dir()}{dst}").is_valid
        to_log(present ? LOG_INFO : LOG_WARNING, "setup_asr_rig: q8_0 ref {dst} — {present ? "ok" : "MISSING (cli refs will time nothing — run --refs)"}\n")
    }
    let mt = stat(mtmd_bin()).is_valid
    to_log(mt ? LOG_INFO : LOG_WARNING, "setup_asr_rig: llama-mtmd-cli — {mt ? mtmd_versions() : "MISSING (audio-chat refs will skip)"}\n")
    for (spec in [(name = "ONNX_PY", py = onnx_py()), (name = "NEMO_PY", py = nemo_py())]) {
        let good = stat(spec.py).is_valid
        to_log(good ? LOG_INFO : LOG_WARNING, "setup_asr_rig: {spec.name} — {good ? "ok" : "missing (those refs will skip)"} ({spec.py})\n")
    }
    // pre-warm the onnx reference models: the first-ever run of a variant downloads its
    // weights, and that download eats the sweep's whole ref-leg budget (~90 s on zen2 —
    // the leg fails "nothing measured" while HF streams). One warm clip per catalog
    // variant here = every sweep leg starts hot.
    if (stat(onnx_py()).is_valid) {
        for (vkey in ["v2-int8", "int8", "whisper-tiny-int8", "whisper-turbo-int8"]) {
            let t0 = ref_time_ticks()
            let out = run_capture_argv([onnx_py(), "{asr_dir()}/onnx_bench.py", "--variant", vkey,
                                        "--reps", "1", "--wav", "{asr_corpus_dir()}jfk.wav",
                                        "--out", asr_pybench_out_path()])
            let rows = find(out, "BENCH") >= 0 || find(fread(asr_pybench_out_path()), "BENCH") >= 0
            to_log(rows ? LOG_INFO : LOG_WARNING,
                "setup_asr_rig: onnx {vkey} pre-warm — {rows ? "ok" : "NO ROWS"} ({get_time_usec(t0) / 1000} ms)\n")
            ok = ok && rows
        }
    }
    to_log(LOG_INFO, "setup_asr_rig: export WHISPER_CPP={whisper_cpp_root()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export MTMD_BIN={mtmd_bin()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export ONNX_PY={onnx_py()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export NEMO_PY={nemo_py()}\n")
    return ok
}

def private is_windows_box() : bool {
    return get_env_variable("OS") == "Windows_NT"
}

[export, tune_policy(missing = "fallback")]
def main : int {
    var r <- parse_args(type<Args>)
    if (r |> is_err) {
        print("error: {r |> unwrap_err}\n\n")
        print_help(get_command_info(type<Args>), "setup_asr_rig")
        return 1
    }
    let cfg <- r |> move_unwrap
    if (cfg.help || !(cfg.corpus || cfg.libri || cfg.refs || cfg.venvs || cfg.check)) {
        print_help(get_command_info(type<Args>), "setup_asr_rig")
        return cfg.help ? 0 : 1
    }
    var ok = true
    if (cfg.refs) {
        ok = setup_refs(cfg) && ok
    }
    if (cfg.corpus) {
        ok = setup_corpus() && ok
    }
    if (cfg.libri) {
        ok = setup_libri() && ok
    }
    if (cfg.venvs) {
        ok = setup_venvs() && ok
    }
    if (cfg.check) {
        ok = check_all() && ok
    }
    to_log(ok ? LOG_INFO : LOG_ERROR, "setup_asr_rig: {ok ? "COMPLETE" : "INCOMPLETE — fix the errors above before sweeping"}\n")
    return ok ? 0 : 1
}
