options gen2
options stack = 524288   // every dasLLAMA program root takes this budget (options stack does not unify up from libs)
options _dasllama_internal = true

require profile_common
require dasllama/dasllama_env
require daslib/tune   // [tune_policy] - inert without dasLLVM
require daslib/clargs
require daslib/fio
require strings
require math

// Builds the ASR half of the profiling rig on a fresh box, so a remote session produces the
// audio board without laptop-local knowledge. Legs (combine freely; --check verifies them all):
//   --corpus  the 5 bench clips: jfk/gb1 copied from $WHISPER_CPP/samples, hp0 fetched from
//             wikimedia + converted, jfk3/hp0x2 regenerated by concatenation; the 3 Russian
//             clips cut from FLEURS by benchmarks/asr/fetch_fleurs_ru.py. Verified against
//             benchmarks/asr/corpus.sha256.
//   --libri   the 25-clip LibriSpeech dictation set (test-clean 1089-134686-0000..0024, OpenSLR
//             SLR12) — fetched, converted to 16 kHz mono wav. Parakeet-v3 scope only.
//   --refs    reference engines: whisper.cpp (whisper-cli + parakeet-cli) at the pinned commit,
//             the mtmd reference at the pinned commit + patches/mtmd-timing.patch, CPU-only build,
//             CrispASR at the pinned commit (a Metal build and a CPU-only build) + the GigaAM q8_0,
//             the Bergamot translation reference: Mozilla's marian-decoder at the pinned commit +
//             benchmarks/nmt/patches (followup_general.md row 258 moves it to a translate rig).
//   --venvs   the reference python environments from requirements-<name>.txt (reference_venvs).
//   --check   verify every input and tool, print the env lines a sweep needs.
//   bin/daslang modules/dasLLAMA/performance/setup_asr_rig.das -- --corpus --check

// The pinned reference commits — the identity the version capture expects (B4). Bumping either
// is a deliberate re-baseline: re-run the sweeps after.
let WHISPER_CPP_COMMIT = "231638a07"
let LLAMA_CPP_COMMIT = "9febe63d5"
let CRISPASR_COMMIT = "119c40317"
let MARIAN_COMMIT = "69455acae"
let LIBRI_URL = "https://www.openslr.org/resources/12/test-clean.tar.gz"
let HP0_URL = "https://upload.wikimedia.org/wikipedia/en/d/d4/En.henryfphillips.ogg"
let GB1_URL = "https://upload.wikimedia.org/wikipedia/commons/1/1f/George_W_Bush_Columbia_FINAL.ogg"

[CommandLineArgs]
struct Args {
    @clarg_doc = "Fetch/regenerate the corpus clips (the 5 English, the 3 Russian) + verify the sha manifest"
    corpus : bool

    @clarg_doc = "Fetch + convert the 25-clip LibriSpeech dictation set"
    libri : bool

    @clarg_doc = "Clone + build the reference engines (whisper.cpp, patched mtmd, CrispASR, patched marian)"
    refs : bool

    @clarg_doc = "Create the reference python venvs (onnx, nemo, tts, gigaam, nmt, mlx on Apple) from the committed requirements"
    venvs : bool

    @clarg_doc = "Verify every rig input and print the env lines a sweep needs"
    check : bool

    @clarg_name = "refs-root"
    @clarg_doc = "Where --refs clones the reference checkouts (default: the directory above the repo)"
    refs_root : string = ".."

    @clarg_short = "?"
    @clarg_doc = "Show this help and exit"
    help : bool
}

def private run_step(what, cmd : string) : bool {
    to_log(LOG_INFO, "setup_asr_rig: {what}\n")
    let out = run_capture("{cmd} 2>&1", false)
    let rc_line = run_capture("echo $?", true)   // popen swallows the status; re-probe cheaply
    if (find(out, "fatal:") >= 0 || find(out, "error:") >= 0 || find(out, "Error") >= 0) {
        to_log(LOG_ERROR, "setup_asr_rig: {what} FAILED - tail: {slice(out, max(0, length(out) - 400))}\n")
        return false
    }
    return !empty(rc_line) || true
}

// ===== corpus =====

// one manifest row: "sha256  name"
def private read_manifest() : array<tuple<sha : string; name : string>> {
    var out : array<tuple<sha : string; name : string>>
    let text = fread("{asr_dir()}/corpus.sha256")
    for (line in split(text, "\n")) {
        let s = strip(line)
        if (empty(s)) {
            continue
        }
        var inscope toks <- [for (tk in split(s, " ")); tk; where !empty(tk)]
        if (length(toks) == 2) {
            out |> push((sha = toks[0], name = toks[1]))
        }
        delete toks
    }
    return <- out
}

def private verify_manifest() : bool {
    var ok = true
    var rows <- read_manifest()
    if (empty(rows)) {
        to_log(LOG_ERROR, "setup_asr_rig: manifest {asr_dir()}/corpus.sha256 missing or empty\n")
        return false
    }
    for (row in rows) {
        let fi = file_identity("{asr_corpus_dir()}{row.name}", "clip")
        if (empty(fi.sha256)) {
            to_log(LOG_ERROR, "setup_asr_rig: corpus {row.name} - MISSING\n")
            ok = false
        } elif (fi.sha256 != row.sha) {
            to_log(LOG_ERROR, "setup_asr_rig: corpus {row.name} - sha MISMATCH (have {slice(fi.sha256, 0, 12)}..., manifest {slice(row.sha, 0, 12)}...) - different bytes would silently bench a different input\n")
            ok = false
        } else {
            to_log(LOG_INFO, "setup_asr_rig: corpus {row.name} - ok\n")
        }
    }
    delete rows
    return ok
}

// WAV concat for identical-format PCM files: first file's header, data chunks appended, RIFF and
// data sizes patched. Deterministic — no decoder in the path, so the manifest holds across boxes.
def private concat_wav(src : string; times : int; dst : string) : bool {
    var bytes : array<uint8>
    let src_sz = int64(stat(src).size)
    fopen(src, "rb") $(f) {
        if (f != null) {
            fload(f, src_sz) $(data) {
                bytes := data
            }
        }
    }
    if (length(bytes) < 44) {
        to_log(LOG_ERROR, "setup_asr_rig: {src} - not a wav\n")
        return false
    }
    // locate the data chunk (after fmt and any LIST/INFO chunks)
    var pos = 12
    var data_off = -1
    var data_len = 0
    while (pos + 8 <= length(bytes)) {
        let id = "{to_char(int(bytes[pos]))}{to_char(int(bytes[pos + 1]))}{to_char(int(bytes[pos + 2]))}{to_char(int(bytes[pos + 3]))}"
        let sz = int(bytes[pos + 4]) | (int(bytes[pos + 5]) << 8) | (int(bytes[pos + 6]) << 16) | (int(bytes[pos + 7]) << 24)
        if (id == "data") {
            data_off = pos + 8
            data_len = sz
            break
        }
        pos += 8 + sz + (sz & 1)
    }
    if (data_off < 0) {
        to_log(LOG_ERROR, "setup_asr_rig: {src} - no data chunk\n")
        return false
    }
    let total_data = data_len * times
    var out : array<uint8>
    out |> reserve(data_off + total_data)
    for (i in range(data_off)) {
        out |> push(bytes[i])
    }
    for (_t in range(times)) {
        for (i in range(data_len)) {
            out |> push(bytes[data_off + i])
        }
    }
    // patch RIFF size (bytes 4..7 = filesize-8) and the data chunk size
    let riff_sz = length(out) - 8
    for (i in range(4)) {
        out[4 + i] = uint8((riff_sz >> (8 * i)) & 0xFF)
        out[data_off - 4 + i] = uint8((total_data >> (8 * i)) & 0xFF)
    }
    var wrote = false
    fopen(dst, "wb") $(f) {
        if (f != null) {
            fwrite(f, out)
            wrote = true
        }
    }
    delete bytes
    delete out
    return wrote
}

def private fetch_ogg_as_wav(url, tmp_name, dst : string) {
    let ogg = "{asr_corpus_dir()}{tmp_name}"
    run_capture("curl -sL -o \"{ogg}\" {url}", false)
    run_capture("ffmpeg -y -loglevel error -i \"{ogg}\" -ar 16000 -ac 1 -c:a pcm_s16le \"{dst}\"", false)
    remove(ogg)
}

def private setup_corpus() : bool {
    mkdir_rec(asr_corpus_dir())
    let samples = "{whisper_cpp_root()}/samples"
    // jfk ships inside the whisper.cpp checkout the rig needs anyway; gb1 only ever existed there
    // via `make samples`, so prefer a checkout copy (byte-identical to the manifest source) and
    // fall back to the same wikimedia fetch+convert the Makefile's samples target encodes
    for (name in ["jfk.wav", "gb1.wav"]) {
        let dst = "{asr_corpus_dir()}{name}"
        if (!stat(dst).is_valid) {
            let src = normalize("{samples}/{name}")
            if (stat(src).is_valid) {
                run_capture(is_windows_box() ? "copy \"{src}\" \"{dst}\"" : "cp \"{src}\" \"{dst}\"", false)
            } elif (name == "gb1.wav") {
                fetch_ogg_as_wav(GB1_URL, "_gb1.ogg", dst)
            } else {
                to_log(LOG_ERROR, "setup_asr_rig: {src} missing - clone/checkout whisper.cpp first (--refs)\n")
                return false
            }
        }
    }
    // hp0: wikimedia ogg → 16 kHz mono pcm16 wav (ffmpeg). Decode determinism is verified by the
    // manifest — if this box's ffmpeg produces different bytes, copy hp0.wav from a manifest-clean
    // box instead (BRINGUP.md).
    let hp0 = "{asr_corpus_dir()}hp0.wav"
    if (!stat(hp0).is_valid) {
        fetch_ogg_as_wav(HP0_URL, "_hp0.ogg", hp0)
    }
    // the two long-form fixtures are concatenations of the above — regenerated, never fetched
    if (!stat("{asr_corpus_dir()}jfk3.wav").is_valid) {
        if (!concat_wav("{asr_corpus_dir()}jfk.wav", 3, "{asr_corpus_dir()}jfk3.wav")) {
            return false
        }
    }
    if (!stat("{asr_corpus_dir()}hp0x2.wav").is_valid) {
        if (!concat_wav(hp0, 2, "{asr_corpus_dir()}hp0x2.wav")) {
            return false
        }
    }
    let ru_missing = [for (n in ["ru_short.wav", "ru_mid.wav", "ru_long.wav", "ru_fleurs.json"]);
        n; where !stat("{asr_corpus_dir()}{n}").is_valid]
    if (!empty(ru_missing)) {
        if (!stat(gigaam_py()).is_valid) {
            to_log(LOG_ERROR, "setup_asr_rig: the Russian clips ({join(ru_missing, ", ")}) mint through the gigaam venv ({gigaam_py()}) - run --venvs first\n")
            return false
        }
        to_log(LOG_INFO, run_capture_argv([gigaam_py(), "-I", "{asr_dir()}/fetch_fleurs_ru.py", "--out", asr_corpus_dir()]))
    }
    return verify_manifest()
}

// ===== libri =====

def private setup_libri() : bool {
    let dir = "{asr_corpus_dir()}librispeech/"
    mkdir_rec(dir)
    var have = 0
    dir(dir) $(fn) {
        if (ends_with(fn, ".wav")) {
            have++
        }
    }
    if (have >= 25) {
        to_log(LOG_INFO, "setup_asr_rig: librispeech - {have} clip(s) already present\n")
        return true
    }
    to_log(LOG_INFO, "setup_asr_rig: fetching LibriSpeech test-clean (346 MB, one-time)\n")
    let tarball = "{asr_corpus_dir()}_test-clean.tar.gz"
    run_capture("curl -sL -o \"{tarball}\" {LIBRI_URL}", false)
    if (!stat(tarball).is_valid) {
        to_log(LOG_ERROR, "setup_asr_rig: LibriSpeech download failed\n")
        return false
    }
    // extract only the one chapter the rig uses
    run_capture("tar -xzf \"{tarball}\" -C \"{asr_corpus_dir()}\" LibriSpeech/test-clean/1089/134686", false)
    for (i in range(25)) {
        let nn = i + 1 < 10 ? "0{i + 1}" : "{i + 1}"
        let utt = i < 10 ? "000{i}" : "00{i}"
        let flac = "{asr_corpus_dir()}LibriSpeech/test-clean/1089/134686/1089-134686-{utt}.flac"
        let wav = "{dir}{nn}_1089-134686-{utt}.wav"
        if (!stat(wav).is_valid) {
            run_capture("ffmpeg -y -loglevel error -i \"{flac}\" -ar 16000 -ac 1 -c:a pcm_s16le \"{wav}\"", false)
        }
        if (!stat(wav).is_valid) {
            to_log(LOG_ERROR, "setup_asr_rig: libri clip {wav} failed to convert\n")
            return false
        }
    }
    remove(tarball)
    run_capture("rm -rf \"{asr_corpus_dir()}LibriSpeech\"", false)
    to_log(LOG_INFO, "setup_asr_rig: librispeech - 25 clip(s) ready\n")
    return true
}

// ===== refs + venvs =====

//! True when the mtmd checkout carries the timing patch - the `MTMD_TIMING` line the record parser
//! reads; an unpatched build runs and prints no timing, so every reference cell of it fails late.
def private mtmd_tree_patched(root : string) : bool =>
    find(fread(normalize("{root}/tools/mtmd/mtmd-cli.cpp")), "MTMD_TIMING") >= 0

//! True when the checkout's HEAD is the pinned commit - a re-pin rebuilds a reference whose
//! binaries an older pin left behind, since the version capture records HEAD, not the build.
def private at_commit(root, pin : string) : bool {
    let head = strip(run_capture("git -C \"{root}\" rev-parse HEAD 2>&1", true))
    return !empty(pin) && head |> starts_with(pin)
}

//! A reference's checkout at its pin: cloned from `url` into `root` when absent, fetched and checked out at `pin` (its
//! submodules with it under `submodules`); answers whether HEAD sat elsewhere before - a moved pin rebuilds.
def private pinned_checkout(name, url, root, pin : string; submodules : bool) : bool {
    if (!stat(normalize("{root}/CMakeLists.txt")).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: cloning {name} @ {pin}\n")
        run_capture("git clone {url} \"{root}\"", false)
    }
    let moved = !at_commit(root, pin)
    let subs = submodules ? " && git -C \"{root}\" submodule update -q --init --recursive" : ""
    run_capture("git -C \"{root}\" fetch -q origin && git -C \"{root}\" checkout -q {pin}{subs}", false)
    return moved
}

//! The q8_0 sibling `dst` of the reference carrier `src` (both under `dir`) through the reference's own quantize tool `quant`;
//! idempotent - a present sibling, or an absent source, is left alone. False where the run made no sibling.
def private quantize_sibling(quant, dir, src, dst : string) : bool {
    let src_path = "{dir}{src}"
    let dst_path = "{dir}{dst}"
    return true if (!stat(src_path).is_valid || stat(dst_path).is_valid)
    to_log(LOG_INFO, "setup_asr_rig: quantizing {src} -> {dst} (q8_0)\n")
    // `call ` so the line never STARTS with a quote — cmd.exe strips a leading one
    // and mangles the rest (the daspkg release_tuner_cmd rule, hit live on zen2)
    let lead = is_windows_box() ? "call " : ""
    run_capture("{lead}\"{quant}\" \"{src_path}\" \"{dst_path}\" q8_0", false)
    if (!stat(dst_path).is_valid) {
        to_log(LOG_WARNING, "setup_asr_rig: q8_0 sibling {dst} did not materialize - the {base_name(quant)} run failed\n")
        return false
    }
    return true
}

def private setup_refs(cfg : Args) : bool {
    var ok = true
    // whisper.cpp (carries whisper-cli AND parakeet-cli upstream)
    let wroot = whisper_cpp_root()
    let wmoved = pinned_checkout("whisper.cpp", "https://github.com/ggml-org/whisper.cpp.git", wroot, WHISPER_CPP_COMMIT, false)
    if (wmoved || !stat(whisper_cpp_bin("whisper-cli")).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: building whisper.cpp (whisper-cli + parakeet-cli)\n")
        run_capture("cmake -S \"{wroot}\" -B \"{wroot}/build\" -DCMAKE_BUILD_TYPE=Release && cmake --build \"{wroot}/build\" --config Release -j 8", false)
    }
    ok = ok && stat(whisper_cpp_bin("whisper-cli")).is_valid && stat(whisper_cpp_bin("parakeet-cli")).is_valid
    // the q8_0 reference siblings the catalog's cli refs time (upstream quantize tools)
    for (pair in [(quant = "whisper-quantize", src = "ggml-tiny.bin", dst = "ggml-tiny-q8_0.bin"),
                  (quant = "whisper-quantize", src = "ggml-large-v3-turbo.bin", dst = "ggml-large-v3-turbo-q8_0.bin"),
                  (quant = "parakeet-quantize", src = "ggml-parakeet-tdt-0.6b-v2-f32.bin", dst = "ggml-parakeet-tdt-0.6b-v2-q8_0.bin"),
                  (quant = "parakeet-quantize", src = "ggml-parakeet-tdt-0.6b-v3-f32.bin", dst = "ggml-parakeet-tdt-0.6b-v3-q8_0.bin")]) {
        ok = quantize_sibling(whisper_cpp_bin(pair.quant), whisper_models_dir(), pair.src, pair.dst) && ok
    }
    // patched CPU-only mtmd
    let lroot = normalize("{cfg.refs_root}/llama.cpp-mtmd-ref")
    let lmoved = stat(normalize("{lroot}/CMakeLists.txt")).is_valid && (!at_commit(lroot, LLAMA_CPP_COMMIT) || !mtmd_tree_patched(lroot))
    if (lmoved || !stat(mtmd_bin()).is_valid) {
        if (!stat(normalize("{lroot}/CMakeLists.txt")).is_valid) {
            to_log(LOG_INFO, "setup_asr_rig: cloning llama.cpp @ {LLAMA_CPP_COMMIT} for the mtmd reference\n")
            run_capture("git clone https://github.com/ggml-org/llama.cpp.git \"{lroot}\"", false)
        }
        // -f drops the previous pin's applied patch, so the patch lands on a clean tree
        run_capture("git -C \"{lroot}\" fetch -q origin && git -C \"{lroot}\" checkout -q -f {LLAMA_CPP_COMMIT}", false)
        let patch = get_full_file_name("{asr_dir()}/patches/mtmd-timing.patch")
        run_capture("git -C \"{lroot}\" apply -3 \"{patch}\"", false)
        if (!mtmd_tree_patched(lroot)) {
            to_log(LOG_ERROR, "setup_asr_rig: mtmd-timing.patch did not apply at {LLAMA_CPP_COMMIT} - port the patch to the pin (benchmarks/asr/patches/README.md)\n")
            return false
        }
        to_log(LOG_INFO, "setup_asr_rig: building llama-mtmd-cli (CPU-only: Metal OFF)\n")
        run_capture("cmake -S \"{lroot}\" -B \"{lroot}/build-cpu\" -DCMAKE_BUILD_TYPE=Release -DGGML_METAL=OFF && cmake --build \"{lroot}/build-cpu\" --config Release -j 8 --target llama-mtmd-cli", false)
        to_log(LOG_INFO, "setup_asr_rig: set MTMD_BIN={lroot}/build-cpu/bin/llama-mtmd-cli\n")
    }
    // the Metal twin (Apple boxes): the same patched checkout, Metal ON
    if (is_apple_box() && (lmoved || !stat(mtmd_bin_metal()).is_valid) && stat(normalize("{lroot}/CMakeLists.txt")).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: building llama-mtmd-cli (build-metal: Metal ON)\n")
        run_capture("cmake -S \"{lroot}\" -B \"{lroot}/build-metal\" -DCMAKE_BUILD_TYPE=Release && cmake --build \"{lroot}/build-metal\" --config Release -j 8 --target llama-mtmd-cli", false)
        if (empty(mtmd_bin_metal())) {
            to_log(LOG_WARNING, "setup_asr_rig: build-metal mtmd did not materialize - the gpu ref leg will skip\n")
            ok = false
        }
    }
    ok = setup_marian() && ok
    return setup_crispasr() && ok
}

//! True when the marian checkout carries the stage-dump patch - an unpatched decoder translates
//! and writes no stage, so every oracle dump of it comes back empty.
def private marian_tree_patched(root : string) : bool =>
    find(fread(normalize("{root}/inference/marian-fork/src/graph/expression_graph.cpp")), "MARIAN_DUMP_DIR") >= 0

//! The Bergamot translation reference: Mozilla's `translations` repository at `MARIAN_COMMIT`, its `inference/`
//! tree alone (the training pipeline stays unfetched) with every submodule but emsdk, patched with
//! `benchmarks/nmt/patches`, and its `marian-decoder` built CPU-only.
def private setup_marian() : bool {
    let root = marian_root()
    let present = stat(normalize("{root}/.git")).is_valid
    if (present && at_commit(root, MARIAN_COMMIT) && marian_tree_patched(root) && stat(marian_bin()).is_valid) {
        return true
    }
    if (!present) {
        to_log(LOG_INFO, "setup_asr_rig: cloning Mozilla translations @ {MARIAN_COMMIT} (inference/ only)\n")
        run_capture("git clone -q --filter=blob:none --sparse https://github.com/mozilla/translations.git \"{root}\" && git -C \"{root}\" sparse-checkout set inference", false)
    }
    let spm = "inference/marian-fork/src/3rd_party/sentencepiece"
    // -f drops the previous pin's applied patch, so the patch lands on a clean tree
    if (stat(normalize("{root}/{spm}/.git")).is_valid) {
        run_capture("git -C \"{root}/{spm}\" checkout -q -f .", false)
    }
    run_capture("git -C \"{root}\" fetch -q origin && git -C \"{root}\" checkout -q -f {MARIAN_COMMIT}", false)
    let subs = run_capture("git -C \"{root}\" config -f .gitmodules --get-regexp path", false)
    let paths <- [for (line in split(subs, "\n")); line |> slice(find(line, " ") + 1) |> strip;
                  where find(line, "inference/") >= 0 && find(line, "emsdk") < 0]
    run_capture("git -C \"{root}\" submodule update -q --init --recursive --depth 1 {join(paths, " ")}", false)
    let patches = get_full_file_name("{nmt_dir()}/patches")
    run_capture("git -C \"{root}\" apply \"{patches}/marian-oracle.patch\" && git -C \"{root}/{spm}\" apply \"{patches}/marian-sentencepiece.patch\"", false)
    if (!marian_tree_patched(root)) {
        to_log(LOG_ERROR, "setup_asr_rig: marian-oracle.patch did not apply at {MARIAN_COMMIT} - port the patch to the pin (benchmarks/nmt/patches/README.md)\n")
        return false
    }
    to_log(LOG_INFO, "setup_asr_rig: building marian-decoder (CPU-only)\n")
    let build = "{root}/inference/build"
    // gcc 12 flags the reference build's bundled GEMM kernels maybe-uninitialized under -march=native; the cache seed puts -Wno-error for that one warning ahead of its own -Werror
    let werror_relief = is_apple_box() || is_windows_box() ? "" : " -DALL_WARNINGS=-Wno-error=maybe-uninitialized"
    run_capture("cmake -S \"{root}/inference\" -B \"{build}\" -DCMAKE_BUILD_TYPE=Release -DCOMPILE_CUDA=off -DUSE_FBGEMM=off -DGIT_SUBMODULE=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5{werror_relief} && cmake --build \"{build}\" --config Release -j 8 --target marian_decoder", false)
    let built = stat(marian_bin()).is_valid
    to_log(built ? LOG_INFO : LOG_ERROR, "setup_asr_rig: marian-decoder - {built ? "ok" : "did not materialize"} ({marian_bin()})\n")
    return built
}

//! CrispASR (the GigaAM reference): the pinned checkout with its ggml submodule, built twice - `build/`
//! with Metal on Apple boxes (the gpu leg) and `build-cpu/` with Metal OFF (the CPU leg) - then
//! the q8_0 sibling of the GigaAM f16 carrier through its own quantize tool.
[arch(at="../ARCHITECTURE_MEASUREMENT_AUDIO.md#asr-cpu-references")]
def private setup_crispasr() : bool {
    let croot = crispasr_root()
    // the build refuses to configure without the bundled ggml submodule
    let moved = pinned_checkout("CrispASR", "https://github.com/CrispStrobe/CrispASR.git", croot, CRISPASR_COMMIT, true)
    if (moved || !stat(crispasr_bin(false)).is_valid) {
        to_log(LOG_INFO, "setup_asr_rig: building CrispASR (build-cpu: Metal OFF)\n")
        run_capture("cmake -S \"{croot}\" -B \"{croot}/build-cpu\" -DCMAKE_BUILD_TYPE=Release -DGGML_METAL=OFF && cmake --build \"{croot}/build-cpu\" --config Release -j 8 --target crispasr-cli crispasr-quantize", false)
    }
    if (is_apple_box() && (moved || !stat(crispasr_bin(true)).is_valid)) {
        to_log(LOG_INFO, "setup_asr_rig: building CrispASR (build: Metal ON)\n")
        run_capture("cmake -S \"{croot}\" -B \"{croot}/build\" -DCMAKE_BUILD_TYPE=Release -DGGML_METAL=ON && cmake --build \"{croot}/build\" --config Release -j 8 --target crispasr-cli", false)
    }
    let built = stat(crispasr_bin(false)).is_valid && (!is_apple_box() || stat(crispasr_bin(true)).is_valid)
    var quantized = true
    let quant = crispasr_bin(false, "crispasr-quantize")
    for (q in crispasr_q8_siblings()) {
        quantized = quantize_sibling(quant, q.dir, q.src, q.dst) && quantized
    }
    return built && quantized
}

//! A CrispASR-derived q8_0 carrier `dst` beside the f16 GGUF `src` it quantizes, both under `dir`.
struct private CrispQ8Sibling {
    dir : string
    src : string
    dst : string
}

//! The catalog's `CRISPASR_Q8_RECIPE` companions, each beside its spec's das-side carrier.
def private crispasr_q8_siblings() : array<CrispQ8Sibling> {
    var out : array<CrispQ8Sibling>
    for (spec in asr_catalog()) {
        out |> push_from([for (c in spec.companions);
            CrispQ8Sibling(dir = spec.root, src = spec.das_model, dst = c.name);
            where c.recipe == CRISPASR_Q8_RECIPE])
    }
    return <- out
}

//! The catalog's onnx reference variants, the keys `onnx_bench.py --variant` takes.
def private onnx_variant_keys() : array<string> {
    var out : array<string>
    for (spec in asr_catalog()) {
        out |> push_from([for (rf in spec.refs); rf.handle; where rf.tool == "onnx"])
    }
    return <- out
}

def private probe_python_version(cand : string) : int =>
    to_int(strip(run_capture("{cand} -c \"import sys; print(sys.version_info.major * 100 + sys.version_info.minor)\" 2>&1", true)))

// the base interpreter: POSIX ships `python3`, Windows ships `python` (and a Store-alias stub
// that answers `python3` with an install nag) — probe in order. The pins were frozen on
// CPython 3.11 and 3.13 breaks them (the numpy pin has no cp313 wheel — pip falls into a
// Meson source build), so only 3.10-3.12 qualifies; a uv-managed interpreter is the fallback
// when every PATH python is outside the range.
def private base_python() : string {
    let pinned = normalize(g_env_prof.base_python)
    if (!empty(pinned)) {
        let pv = probe_python_version(pinned)
        if (pv >= 310 && pv < 313) {
            return pinned
        }
        to_log(LOG_WARNING, "setup_asr_rig: DASLLAMA_BASE_PYTHON={pinned} probes as {pv} - outside 3.10-3.12, ignoring\n")
    }
    for (cand in ["python3.11", "python3.10", "python3.12", "python3", "python"]) {
        let v = probe_python_version(cand)
        if (v >= 310 && v < 313) {
            return cand
        }
    }
    for (ver in ["3.11", "3.10", "3.12"]) {
        let p = normalize(strip(run_capture("uv python find {ver} 2>&1", true)))
        if (stat(p).is_valid && probe_python_version(p) >= 310) {
            return p
        }
    }
    return ""
}

def private setup_venvs() : bool {
    // the pins in requirements-*.txt were frozen on CPython 3.11 — an older interpreter dies
    // five screens deep in pip resolution, so gate LOUDLY first. No-admin install route (a
    // fresh mac's CLT python is 3.9): `curl -LsSf https://astral.sh/uv/install.sh | sh`,
    // `uv python install 3.11`, put its bin dir first on PATH.
    let basepy = base_python()
    if (empty(basepy)) {
        to_log(LOG_ERROR, "setup_asr_rig: no CPython 3.10-3.12 found (PATH names or uv) - the venv pins were frozen on 3.11 and 3.13+ breaks them; `uv python install 3.11` (uv route above) and re-run\n")
        return false
    }
    var ok = true
    for (spec in reference_venvs()) {
        if (spec.apple_only && !is_apple_silicon()) {
            to_log(LOG_INFO, "setup_asr_rig: {spec.name} venv - Apple-only, skipped\n")
            continue
        }
        // present = the interpreter exists AND the pinned packages import — a half-made venv
        // (pip died mid-install) leaves the interpreter behind and must be rebuilt, not skipped
        if (stat(spec.py).is_valid && venv_ready(spec.py, spec.probe)) {
            to_log(LOG_INFO, "setup_asr_rig: {spec.name} venv - present\n")
            continue
        }
        let venv = normalize("{asr_dir()}/.venv-{spec.name}")
        if (stat(venv).is_valid) {
            to_log(LOG_WARNING, "setup_asr_rig: {spec.name} venv at {venv} is half-made - rebuilding\n")
            run_capture("rm -rf \"{venv}\"", false)
        }
        to_log(LOG_INFO, "setup_asr_rig: creating {spec.name} venv at {venv} (base: {basepy})\n")
        run_capture("{basepy} -m venv {venv}", false)
        let py = venv_python(venv)
        let req = normalize("{asr_dir()}/requirements-{spec.name}.txt")
        run_capture("{py} -m pip -q install -r {req}", false)
        // gate on the PACKAGES importing, not the interpreter existing — pip dying after
        // `python -m venv` succeeded leaves a stat-able python.exe over an empty site-packages
        if (stat(py).is_valid && venv_ready(py, spec.probe)) {
            to_log(LOG_INFO, "setup_asr_rig: set {spec.env}={py}\n")
        } else {
            to_log(LOG_ERROR, "setup_asr_rig: {spec.name} venv creation failed\n")
            ok = false
        }
    }
    return ok
}

struct private ReferenceVenv {
    name : string        // requirements-<name>.txt builds .venv-<name> under the asr dir
    py : string          // the interpreter the records rig resolves for it
    probe : string       // the package whose import proves the venv whole
    env : string         // the override variable naming another interpreter
    apple_only : bool    // MLX runs on Apple silicon alone
}

def private reference_venvs() : array<ReferenceVenv> {
    return <- [
        ReferenceVenv(name = "onnx", py = onnx_py(), probe = "onnx_asr", env = "ONNX_PY"),
        ReferenceVenv(name = "nemo", py = nemo_py(), probe = "nemo", env = "NEMO_PY"),
        ReferenceVenv(name = "mlx", py = mlx_py(), probe = "mlx_audio, mlx_lm", env = "MLX_PY", apple_only = true),
        ReferenceVenv(name = "tts", py = tts_py(), probe = "kokoro, kittentts, onnxruntime, pocket_tts", env = "TTS_PY"),
        ReferenceVenv(name = "gigaam", py = gigaam_py(), probe = "gigaam, torch", env = "GIGAAM_PY"),
        ReferenceVenv(name = "nmt", py = nmt_py(), probe = "numpy, sentencepiece", env = "NMT_PY")
    ]
}

def private is_apple_silicon() : bool => get_platform_name() == "darwin" && get_architecture_name() == "arm64"

def private venv_ready(py, probe : string) : bool {
    let devnull = is_windows_box() ? "2>nul" : "2>/dev/null"
    let out = run_capture("{py} -c \"import {probe}; print(1)\" {devnull}", true)
    return to_int(strip(out)) == 1
}

// ===== check =====

//! One warm clip per python reference variant - the catalog's mlx refs and the onnx variants the
//! sweep runs: the first-ever run of a variant downloads its weights, which would eat a sweep leg's budget.
def private prewarm_python_refs() : bool {
    var ok = true
    if (is_apple_silicon() && stat(mlx_py()).is_valid) {
        for (spec in asr_catalog()) {
            for (rf in spec.refs) {
                continue if (rf.tool != "mlx")
                let t0 = ref_time_ticks()
                let out = run_capture_argv([mlx_py(), "{asr_dir()}/mlx_asr_bench.py", "--variant", rf.handle,
                                            "--reps", "1", "--wav", "{asr_corpus_dir()}jfk.wav"])
                let rows = find(out, "BENCH") >= 0
                to_log(rows ? LOG_INFO : LOG_WARNING,
                    "setup_asr_rig: mlx {rf.handle} pre-warm - {rows ? "ok" : "NO ROWS"} ({get_time_usec(t0) / 1000} ms)\n")
                ok = ok && rows
            }
        }
    }
    if (stat(onnx_py()).is_valid) {
        for (vkey in onnx_variant_keys()) {
            let t0 = ref_time_ticks()
            let out = run_capture_argv([onnx_py(), "{asr_dir()}/onnx_bench.py", "--variant", vkey,
                                        "--reps", "1", "--wav", "{asr_corpus_dir()}jfk.wav",
                                        "--out", asr_pybench_out_path()])
            let rows = find(out, "BENCH") >= 0 || find(fread(asr_pybench_out_path()), "BENCH") >= 0
            to_log(rows ? LOG_INFO : LOG_WARNING,
                "setup_asr_rig: onnx {vkey} pre-warm - {rows ? "ok" : "NO ROWS"} ({get_time_usec(t0) / 1000} ms)\n")
            ok = ok && rows
        }
    }
    return ok
}

//! The CrispASR builds and the GigaAM q8_0 carrier, logged; an absent one skips its refs, never fails the check.
def private check_crispasr() {
    for (gpu in [false, true]) {
        continue if (gpu && !is_apple_box())
        let bin = crispasr_bin(gpu)
        let good = stat(bin).is_valid
        to_log(good ? LOG_INFO : LOG_WARNING, "setup_asr_rig: crispasr ({gpu ? "Metal" : "CPU-only"}) - {good ? crispasr_versions() : "MISSING (the GigaAM refs will skip - run --refs)"} ({bin})\n")
    }
    for (q in crispasr_q8_siblings()) {
        let gq = stat("{q.dir}{q.dst}").is_valid
        to_log(gq ? LOG_INFO : LOG_WARNING, "setup_asr_rig: q8_0 ref {q.dst} - {gq ? "ok" : "MISSING (run --refs)"}\n")
    }
}

def private check_all() : bool {
    var ok = verify_manifest()
    for (tool in ["whisper-cli", "parakeet-cli"]) {
        let bin = whisper_cpp_bin(tool)
        let good = stat(bin).is_valid
        to_log(good ? LOG_INFO : LOG_ERROR, "setup_asr_rig: {tool} - {good ? "ok" : "MISSING"} ({bin})\n")
        ok = ok && good
    }
    let versions = whisper_cpp_versions()
    to_log(LOG_INFO, "setup_asr_rig: {empty(versions) ? "whisper.cpp checkout not identified" : versions}\n")
    ok = ok && find(versions, "+dirty") < 0
    for (dst in ["ggml-tiny-q8_0.bin", "ggml-large-v3-turbo-q8_0.bin",
                 "ggml-parakeet-tdt-0.6b-v2-q8_0.bin", "ggml-parakeet-tdt-0.6b-v3-q8_0.bin"]) {
        let present = stat("{whisper_models_dir()}{dst}").is_valid
        to_log(present ? LOG_INFO : LOG_WARNING, "setup_asr_rig: q8_0 ref {dst} - {present ? "ok" : "MISSING (cli refs will time nothing - run --refs)"}\n")
    }
    let mt = stat(mtmd_bin()).is_valid
    to_log(mt ? LOG_INFO : LOG_WARNING, "setup_asr_rig: llama-mtmd-cli - {mt ? mtmd_versions() : "MISSING (audio-chat refs will skip)"}\n")
    if (mt && !mtmd_tree_patched(dir_name(dir_name(dir_name(mtmd_bin()))))) {
        to_log(LOG_ERROR, "setup_asr_rig: llama-mtmd-cli's checkout carries no MTMD_TIMING - the timing patch is not applied; run --refs\n")
        ok = false
    }
    check_crispasr()
    let mb = stat(marian_bin()).is_valid
    to_log(mb ? LOG_INFO : LOG_WARNING, "setup_asr_rig: marian-decoder - {mb ? marian_versions() : "MISSING (the translation refs will skip - run --refs)"} ({marian_bin()})\n")
    for (spec in reference_venvs()) {
        continue if (spec.apple_only && !is_apple_silicon())
        let good = stat(spec.py).is_valid
        to_log(good ? LOG_INFO : LOG_WARNING, "setup_asr_rig: {spec.env} - {good ? "ok" : "missing (those refs will skip)"} ({spec.py})\n")
    }
    ok = prewarm_python_refs() && ok
    to_log(LOG_INFO, "setup_asr_rig: export WHISPER_CPP={whisper_cpp_root()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export MTMD_BIN={mtmd_bin()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export CRISPASR={crispasr_root()}\n")
    to_log(LOG_INFO, "setup_asr_rig: export MARIAN={marian_root()}\n")
    for (spec in reference_venvs()) {
        continue if (spec.apple_only && !is_apple_silicon())
        to_log(LOG_INFO, "setup_asr_rig: export {spec.env}={spec.py}\n")
    }
    return ok
}

def private is_windows_box() : bool => g_env_prof.win_os == "Windows_NT"

[export, tune_policy(missing = "fallback")]
def main : int {
    var r <- parse_args(type<Args>)
    if (r |> is_err) {
        print("error: {r |> unwrap_err}\n\n")
        print_help(get_command_info(type<Args>), "setup_asr_rig")
        return 1
    }
    let cfg <- r |> move_unwrap
    if (cfg.help || !(cfg.corpus || cfg.libri || cfg.refs || cfg.venvs || cfg.check)) {
        print_help(get_command_info(type<Args>), "setup_asr_rig")
        return cfg.help ? 0 : 1
    }
    var ok = true
    if (cfg.refs) {
        ok = setup_refs(cfg) && ok
    }
    if (cfg.corpus) {
        ok = setup_corpus() && ok
    }
    if (cfg.libri) {
        ok = setup_libri() && ok
    }
    if (cfg.venvs) {
        ok = setup_venvs() && ok
    }
    if (cfg.check) {
        ok = check_all() && ok
    }
    to_log(ok ? LOG_INFO : LOG_ERROR, "setup_asr_rig: {ok ? "COMPLETE" : "INCOMPLETE - fix the errors above before sweeping"}\n")
    return ok ? 0 : 1
}
