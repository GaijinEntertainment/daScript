# The engine's added lines run past the repo's line-length limits: the module predates the gate,
# and its kernel stamps and test cells were written to its own wider width. Both measures are
# unchecked here until the sweep followup_general.md row 213 names wraps the tree; then this file
# goes and the repo limits bind. A kernel body's width is the stamp's, never the gate's.
[line_length]
code = 0
comment = 0
