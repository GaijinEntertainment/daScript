options gen2

require daslib/daspkg

[export]
def package() {
    package_name("wasm_export")
    package_description("the profile export as a wasm64 release - it reads the sidecar the wasm tuner minted")
}

[export]
def release() {
    release_main("../../export_tune_profile.das")
    release_wasm_disable_host_gpu_modules()
    release_emcc_arg("-lnodefs.js")
}
