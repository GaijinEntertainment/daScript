/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public dissolve(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = remap(sin(g_Time * 0.7f),float2(-1f,1f),float2(0.1f,0.9f));
	let _preshader_1:float const = (_preshader_0 + edgeWidth);
	let _preshader_2:float const = mad(edgeWidth,0.4f,_preshader_0);
	let _preshader_3:float const = saturate(g_LightDirection.y);
	let _preshader_4:float const = lerp(0.8f,2f,_preshader_3);
	let n:float const = noise(inp.worldPos * noiseScale);
	let cutoffMask:float const = step(_preshader_0,n);
	let edgeMask:float const = smooth_step(_preshader_0,_preshader_1,n);
	let hotMask:float const = smooth_step(_preshader_0,_preshader_2,n);
	let edgeGlow:float3 const = lerp(edgeHotColor,edgeColor,edgeMask);
	let surface:float3 const = lerp(edgeGlow,baseColor,edgeMask);
	let _cse_0:float const = one_minus(hotMask);
	return struct<PbrOutput>(albedo = (cutoffMask * surface), alpha = mad(edgeMask,one_minus(cutoffMask),cutoffMask), alphaCutoff = 0.5f, emission = (edgeGlow * _cse_0), emissionStrength = (_cse_0 * _preshader_4), metalness = 0f, roughness = 0.8f, ao = 1f);
}
