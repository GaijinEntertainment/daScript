/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flatten:bool=false)]
def public cells4_scalar(inp:PbrInput const) : PbrOutput {
	let uv:float2 const = (inp.uv * 5f);
	let t:float const = (g_Time * 0.3f);
	let cx:float const = floor(uv.x);
	let cy:float const = floor(uv.y);
	let cx1:float const = (cx + 1f);
	let cy1:float const = (cy + 1f);
	let hx0:float const = frac(sin((cx * 127.1f) + (cy * 311.7f)) * 43758.5f);
	let hy0:float const = frac(sin((cx * 269.5f) + (cy * 183.3f)) * 43758.5f);
	let dx0:float const = (mad(sin(mad(hx0,6.28f,t)),0.3f,mad(hx0,0.5f,cx)) - uv.x);
	let dy0:float const = (mad(cos(mad(hy0,6.28f,t)),0.3f,mad(hy0,0.5f,cy)) - uv.y);
	let d0:float const = sqrt(mad(dx0,dx0,dy0 * dy0));
	let hx1:float const = frac(sin((cx1 * 127.1f) + (cy * 311.7f)) * 43758.5f);
	let hy1:float const = frac(sin((cx1 * 269.5f) + (cy * 183.3f)) * 43758.5f);
	let dx1:float const = (mad(sin(mad(hx1,6.28f,t)),0.3f,mad(hx1,0.5f,cx1)) - uv.x);
	let dy1:float const = (mad(cos(mad(hy1,6.28f,t)),0.3f,mad(hy1,0.5f,cy)) - uv.y);
	let d1:float const = sqrt(mad(dx1,dx1,dy1 * dy1));
	let hx2:float const = frac(sin((cx * 127.1f) + (cy1 * 311.7f)) * 43758.5f);
	let hy2:float const = frac(sin((cx * 269.5f) + (cy1 * 183.3f)) * 43758.5f);
	let dx2:float const = (mad(sin(mad(hx2,6.28f,t)),0.3f,mad(hx2,0.5f,cx)) - uv.x);
	let dy2:float const = (mad(cos(mad(hy2,6.28f,t)),0.3f,mad(hy2,0.5f,cy1)) - uv.y);
	let d2:float const = sqrt(mad(dx2,dx2,dy2 * dy2));
	let hx3:float const = frac(sin((cx1 * 127.1f) + (cy1 * 311.7f)) * 43758.5f);
	let hy3:float const = frac(sin((cx1 * 269.5f) + (cy1 * 183.3f)) * 43758.5f);
	let dx3:float const = (mad(sin(mad(hx3,6.28f,t)),0.3f,mad(hx3,0.5f,cx1)) - uv.x);
	let dy3:float const = (mad(cos(mad(hy3,6.28f,t)),0.3f,mad(hy3,0.5f,cy1)) - uv.y);
	let d3:float const = sqrt(mad(dx3,dx3,dy3 * dy3));
	let m:float const = min(min(d0,d1),min(d2,d3));
	return struct<PbrOutput>(albedo = float3(m,m,m), emission = float3(0f,0f,0f), emissionStrength = 0f, metalness = 0f, roughness = 1f, ao = 1f);
}
