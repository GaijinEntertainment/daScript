/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public outline_2d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float2 const = float2(thickness,0f);
	let _preshader_1:float2 const = float2(0f,thickness);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(1f,3f,_preshader_2);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let r:float const = tex2d(albedo_texture,_preshader_0 + inp.uv).x;
	let l:float const = tex2d(albedo_texture,inp.uv - _preshader_0).x;
	let u:float const = tex2d(albedo_texture,_preshader_1 + inp.uv).x;
	let d:float const = tex2d(albedo_texture,inp.uv - _preshader_1).x;
	let gray:float const = dot(c,float3(0.299f,0.587f,0.114f));
	let edge:float const = max(abs(r - l),abs(u - d));
	let outline:float const = (step(0.05f,edge) * step(gray,0.8f));
	return struct<PbrOutput>(albedo = float3(0f,0f,0f), emission = (outline * outlineColor), emissionStrength = (outline * _preshader_3), alpha = outline, alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
