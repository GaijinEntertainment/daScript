// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public dissolve_2d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = remap(sin(g_Time * 0.8f),float2(-1f,1f),float2(0.1f,0.9f));
	let _preshader_1:float const = (_preshader_0 + edgeWidth);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.5f,2f,_preshader_2);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let n:float const = noise(inp.uv * noiseScale);
	let cutoff:float const = step(_preshader_0,n);
	let edge:float const = (smooth_step(_preshader_0,_preshader_1,n) - cutoff);
	let _cse_0:float3 const = (edge * edgeColor);
	let result:float3 const = mad(c,cutoff,_cse_0);
	return struct<PbrOutput>(albedo = result, emission = _cse_0, emissionStrength = _preshader_3, alpha = (cutoff + edge), alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
