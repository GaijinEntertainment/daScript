/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public force_field(inp:PbrInput const) : PbrOutput {
	let _preshader_cse_0:float const = (g_Time * pulseSpeed);
	let _preshader_0:float const = (_preshader_cse_0 * 0.3f);
	let _preshader_1:float3 const = float3(0,_preshader_0,0);
	let _preshader_2:float const = (0.5f - gridLineWidth);
	let _preshader_4:float const = saturate(g_LightDirection.y);
	let _preshader_5:float const = lerp(0.4f,1.5f,_preshader_4);
	let gridUV:float3 const = mad(inp.worldPos,gridScale,_preshader_1);
	let g:float3 const = abs(frac(gridUV) - float3(0.5f,0.5f,0.5f));
	let gridMin:float const = min(min(g.x,g.y),g.z);
	let gridMask:float const = smooth_step(_preshader_2,0.5f,gridMin);
	let pulse:float const = mad(sin(mad(inp.worldPos.y,-2f,_preshader_cse_0)),0.5f,0.5f);
	let f:float const = fresnel(fresnelPower,inp.worldNormal,inp.viewDir);
	let rim:float const = pow(f,0.8f);
	let baseGlow:float3 const = (mad(gridMask,0.6f,rim * 0.4f) * fieldColor);
	let pulseGlow:float3 const = (((gridMask * pulse) * pulseColor) * 0.5f);
	return struct<PbrOutput>(albedo = float3(0f,0f,0f), emission = (baseGlow + pulseGlow), emissionStrength = ((gridMask + rim) * _preshader_5), metalness = 0f, roughness = 1f, ao = 1f);
}
