/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public loop_multi(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float2 const = float2(-blurSize,0f);
	let _preshader_1:float2 const = float2(blurSize,0f);
	var __ssa_acc_2:float3 = (tex2d(albedo_texture,_preshader_0 + inp.uv).xyz * 0.25f);
	var __ssa_acc_3:float3 = mad(tex2d(albedo_texture,inp.uv).xyz,0.5f,__ssa_acc_2);
	var __ssa_acc_4:float3 = mad(tex2d(albedo_texture,_preshader_1 + inp.uv).xyz,0.25f,__ssa_acc_3);
	return struct<PbrOutput>(albedo = __ssa_acc_4, emission = __ssa_acc_4, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
