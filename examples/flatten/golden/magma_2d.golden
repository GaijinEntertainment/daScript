/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public magma_2d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (flowSpeed * g_Time);
	let _preshader_1:float2 const = float2(_preshader_0,_preshader_0 * 0.7f);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.5f,2f,_preshader_2);
	let uv:float2 const = mad(inp.uv,noiseScale,_preshader_1);
	let n:float const = noise(uv);
	let crackMask:float const = smooth_step(0.55f,0.85f,n);
	let warmMask:float const = smooth_step(0.3f,0.7f,n);
	let surface:float3 const = lerp(coolColor,hotColor,warmMask);
	return struct<PbrOutput>(albedo = surface, emission = (crackMask * glowColor), emissionStrength = (crackMask * _preshader_3), metalness = 0f, roughness = 0.9f, ao = 1f);
}
