/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public poison(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = mad(sin(g_Time * pulseSpeed),0.5f,0.5f);
	let _preshader_1:float2 const = float2(g_Time * 0.3f,0f);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.5f,2f,_preshader_2);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let n:float const = noise(mad(inp.uv,4f,_preshader_1));
	let mask:float const = (n * _preshader_0);
	let result:float3 const = lerp(c,mad(mask,0.5f,0.5f) * poisonColor,strength);
	return struct<PbrOutput>(albedo = result, emission = ((mask * poisonColor) * strength), emissionStrength = (mask * _preshader_3), metalness = 0f, roughness = 1f, ao = 1f);
}
