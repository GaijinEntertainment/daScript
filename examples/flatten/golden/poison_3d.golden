/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public poison_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = mad(sin(g_Time * pulseSpeed),0.5f,0.5f);
	let _preshader_1:float3 const = float3(0,g_Time * 0.3f,0);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.8f,2f,_preshader_2);
	let n:float const = noise(mad(inp.worldPos,noiseScale,_preshader_1));
	let bubble:float const = (step(0.72f,n) * _preshader_0);
	return struct<PbrOutput>(albedo = lerp(baseColor,poisonColor,n * 0.6f), emission = mad((n * poisonColor) * _preshader_0,0.2f,bubble * bubbleColor), emissionStrength = (bubble * _preshader_3), metalness = 0f, roughness = 0.7f, ao = 1f);
}
