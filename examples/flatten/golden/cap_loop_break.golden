// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cap_loop_break(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float2 const = float2(blurSize,blurSize);
	let _preshader_1:float const = (blurSize * 2f);
	let _preshader_2:float2 const = float2(_preshader_1,_preshader_1);
	let _preshader_3:float const = (blurSize * 3f);
	let _preshader_4:float2 const = float2(_preshader_3,_preshader_3);
	var __flat_loop_0:bool;
	let s_0:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	__flat_loop_0 = s_0.x <= 0.9f;
	var __ssa_acc_2:float3 = (__flat_loop_0 ? s_0 : float3(0f,0f,0f));
	let s_1:float3 const = tex2d(albedo_texture,_preshader_0 + inp.uv).xyz;
	__flat_loop_0 = __flat_loop_0 && (s_1.x <= 0.9f);
	var __ssa_acc_3:float3 = (__flat_loop_0 ? (__ssa_acc_2 + s_1) : __ssa_acc_2);
	let s_2:float3 const = tex2d(albedo_texture,_preshader_2 + inp.uv).xyz;
	__flat_loop_0 = __flat_loop_0 && (s_2.x <= 0.9f);
	var __ssa_acc_4:float3 = (__flat_loop_0 ? (__ssa_acc_3 + s_2) : __ssa_acc_3);
	let s_3:float3 const = tex2d(albedo_texture,_preshader_4 + inp.uv).xyz;
	__flat_loop_0 = __flat_loop_0 && (s_3.x <= 0.9f);
	var __ssa_acc_5:float3 = (__flat_loop_0 ? (__ssa_acc_4 + s_3) : __ssa_acc_4);
	return struct<PbrOutput>(albedo = __ssa_acc_5, emission = __ssa_acc_5, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
