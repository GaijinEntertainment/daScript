// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public wave(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * waveSpeed);
	let _preshader_1:float const = (_preshader_0 * 1.3f);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.5f,2f,_preshader_2);
	let dx:float const = (sin(mad(inp.uv.y,waveFreq,_preshader_0)) * waveAmp);
	let dy:float const = (sin(mad(inp.uv.x,waveFreq,_preshader_1)) * waveAmp);
	let result:float3 const = tex2d(albedo_texture,float2(dx,dy) + inp.uv).xyz;
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = _preshader_3, metalness = 0f, roughness = 1f, ao = 1f);
}
