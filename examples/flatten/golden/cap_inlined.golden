/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cap_inlined(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float3 const = normalize(lightDir);
	let nDotL:float const = saturate(dot(normalize(inp.worldNormal),_preshader_0));
	let lit:float3 const = lerp(shadowColor,baseColor,nDotL);
	return struct<PbrOutput>(albedo = float3(0f,0f,0f), emission = lit, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
