/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public halftone(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = saturate(g_LightDirection.y);
	let _preshader_1:float const = lerp(0.5f,2.5f,_preshader_0);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let gray:float const = dot(c,float3(0.299f,0.587f,0.114f));
	let cell:float2 const = (frac(dotSize * inp.uv) - float2(0.5f,0.5f));
	let dist:float const = length(cell);
	let radius:float const = (gray * 0.5f);
	let mask:float const = step(dist,radius);
	let result:float3 const = (c * mask);
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = _preshader_1, metalness = 0f, roughness = 1f, ao = 1f);
}
