/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public stun_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * speed);
	let _preshader_1:float3 const = float3(_preshader_0,0,0);
	let _preshader_2:float3 const = float3(0,_preshader_0 * 1.3f,0);
	let _preshader_3:float const = (_preshader_0 * 4f);
	let _preshader_4:float const = saturate(g_LightDirection.y);
	let _preshader_5:float const = lerp(0.2f,1.5f,_preshader_4);
	let _cse_0:float3 const = (inp.worldPos * noiseScale);
	let n1:float const = noise(_cse_0 + _preshader_1);
	let n2:float const = noise(mad(_cse_0,2f,_preshader_2));
	let _cse_1:float const = ((n1 * n2) * 2.5f);
	let star:float const = step(0.8f,_cse_1);
	let glow:float const = smooth_step(0.6f,0.8f,_cse_1);
	let wobble:float const = mad(sin(mad(inp.worldPos.y,8f,_preshader_3)),0.5f,0.5f);
	return struct<PbrOutput>(albedo = lerp(baseColor,dimColor,wobble), emission = mad(star * starColor,wobble,dimColor * glow), emissionStrength = (mad(glow,0.3f,star * wobble) * _preshader_5), metalness = 0f, roughness = 0.9f, ao = 1f);
}
