/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public rage_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * pulseSpeed);
	let _preshader_1:float3 const = float3(0,_preshader_0 * 0.3f,0);
	let _preshader_2:float const = mad(sin(_preshader_0),0.5f,0.5f);
	let _preshader_3:float const = saturate(g_LightDirection.y);
	let _preshader_4:float3 const = (coreColor * _preshader_2);
	let _preshader_5:float const = lerp(0.5f,2f,_preshader_3);
	let n:float const = noise(mad(inp.worldPos,noiseScale,_preshader_1));
	let vein:float const = step(0.68f,n);
	let glow:float const = smooth_step(0.55f,0.68f,n);
	return struct<PbrOutput>(albedo = baseColor, emission = mad(_preshader_4,vein,glow * rageColor), emissionStrength = (mad(glow,0.5f,_preshader_2 * vein) * _preshader_5), metalness = 0f, roughness = 0.8f, ao = 1f);
}
