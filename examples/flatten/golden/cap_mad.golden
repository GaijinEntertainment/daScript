/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cap_mad(inp:PbrInput const) : PbrOutput {
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let lum:float const = dot(c,float3(0.299f,0.587f,0.114f));
	let remap:float const = mad(lum,0.5f,0.5f);
	let tinted:float3 const = mad(c,remap,float3(0.04f,0.04f,0.04f));
	let edge:float3 const = lerp(c,float3(1f,1f,1f),remap);
	return struct<PbrOutput>(albedo = tinted, emission = edge, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
