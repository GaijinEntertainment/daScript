// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public emboss(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float2 const = float2(step_size,step_size);
	let tl:float3 const = tex2d(albedo_texture,inp.uv - _preshader_0).xyz;
	let br:float3 const = tex2d(albedo_texture,_preshader_0 + inp.uv).xyz;
	let diff:float const = (dot(br - tl,float3(0.299f,0.587f,0.114f)) * strength);
	let result:float3 const = (float3(0.5f,0.5f,0.5f) + float3(diff));
	return struct<PbrOutput>(albedo = saturate(result), metalness = 0f, roughness = 1f, ao = 1f);
}
