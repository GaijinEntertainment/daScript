[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cap_fold_identity(inp:PbrInput const) : PbrOutput {
	let base:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let result:float3 const = (base * gain);
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
