/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public burn(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (burnSpeed * g_Time);
	let _preshader_1:float const = remap(sin(_preshader_0 * 0.8f),float2(-1f,1f),float2(0.1f,0.9f));
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(1f,3f,_preshader_2);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let n:float const = noise(float2(inp.uv.x * noiseScale,mad(inp.uv.y * noiseScale,0.5f,_preshader_0)));
	let _cse_0:float const = mad(n,0.3f,_preshader_1);
	let _cse_3:float const = (1f - inp.uv.y);
	let burnMask:float const = smooth_step(_cse_0,_cse_0 + 0.05f,_cse_3);
	let edgeMask:float const = (smooth_step(_cse_0 - 0.1f,_cse_0,_cse_3) - burnMask);
	let _cse_1:float3 const = (burnColor * edgeMask);
	let _cse_2:float const = (1f - burnMask);
	return struct<PbrOutput>(albedo = mad(c,_cse_2,_cse_1), emission = _cse_1, emissionStrength = (edgeMask * _preshader_3), alpha = (_cse_2 + edgeMask), alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
