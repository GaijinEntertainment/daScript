// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public dissolve_edge(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = frac(g_Time * speed);
	let _preshader_1:float const = (edgeWidth + _preshader_0);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(1f,3f,_preshader_2);
	let c:float4 const = tex2d(albedo_texture,inp.uv);
	let n:float const = noise(inp.uv * noiseScale);
	let visible:float const = step(_preshader_0,n);
	let edge:float const = (smooth_step(_preshader_0,_preshader_1,n) - visible);
	let glow:float const = saturate(edge);
	let _cse_0:float3 const = (edgeColor * glow);
	let result:float3 const = (_cse_0 + c.xyz);
	return struct<PbrOutput>(albedo = result, emission = _cse_0, emissionStrength = (glow * _preshader_3), alpha = (c.w * visible), alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
