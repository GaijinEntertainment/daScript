/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public shield_hit(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * hitSpeed);
	let _preshader_1:float const = mad(sin(g_Time * 8f),0.5f,0.5f);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.5f,2.5f,_preshader_2);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let uv:float2 const = (inp.uv - float2(0.5f,0.5f));
	let dist:float const = length(uv);
	let pulse:float const = frac((dist * rings) - _preshader_0);
	let ring:float const = (smooth_step(0f,0.3f,pulse) * smooth_step(1f,0.7f,pulse));
	let _cse_0:float const = (_preshader_1 * ring);
	let result:float3 const = lerp(c,shieldColor,_cse_0 * 0.7f);
	return struct<PbrOutput>(albedo = result, emission = (_cse_0 * shieldColor), emissionStrength = (_cse_0 * _preshader_3), metalness = 0f, roughness = 0.2f, ao = 1f);
}
