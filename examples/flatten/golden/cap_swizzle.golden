[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cap_swizzle(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float3 const = normalize(lightDir);
	let rgb:float3 const = (baseColor * saturate(dot(normalize(inp.worldNormal),_preshader_0)));
	return struct<PbrOutput>(albedo = float3(0f,0f,0f), emission = rgb, emissionStrength = 1f, metalness = 0f, roughness = 1f, ao = 1f);
}
