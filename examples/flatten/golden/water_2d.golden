/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public water_2d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * waveSpeed);
	let _preshader_1:float2 const = float2(_preshader_0,_preshader_0 * 0.7f);
	let _preshader_2:float2 const = float2(_preshader_0 * 1.6f,0f);
	let _preshader_3:float const = (foamThreshold + 0.15f);
	let _preshader_4:float const = saturate(g_LightDirection.y);
	let _preshader_5:float const = lerp(0.3f,1.5f,_preshader_4);
	let _cse_0:float2 const = (inp.uv * waveScale);
	let n1:float const = noise(_cse_0 + _preshader_1);
	let n2:float const = noise(mad(_cse_0,2.1f,_preshader_2));
	let n:float const = mad(n1,0.55f,n2 * 0.45f);
	let depthMix:float3 const = lerp(deepColor,shallowColor,n);
	let foamMask:float const = smooth_step(foamThreshold,_preshader_3,n);
	let result:float3 const = lerp(depthMix,foamColor,foamMask);
	return struct<PbrOutput>(albedo = result, emission = mad(foamColor * foamMask,0.3f,result), emissionStrength = _preshader_5, metalness = 0f, roughness = 0.2f, ao = 1f);
}
