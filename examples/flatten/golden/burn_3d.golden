/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public burn_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (burnSpeed * g_Time);
	let _preshader_1:float const = remap(sin(_preshader_0 * 0.8f),float2(-1f,1f),float2(0.1f,0.9f));
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(1.5f,3f,_preshader_2);
	let n:float const = noise(float3(inp.worldPos.x * noiseScale,mad(inp.worldPos.y * noiseScale,0.5f,_preshader_0),inp.worldPos.z * noiseScale));
	let h:float const = mad(inp.localPos.y,0.5f,0.5f);
	let _cse_0:float const = mad(n,0.25f,_preshader_1);
	let burnMask:float const = step(_cse_0,h);
	let edgeMask:float const = (smooth_step(_cse_0 - 0.08f,_cse_0,h) - burnMask);
	return struct<PbrOutput>(albedo = (ashColor * burnMask), emission = (burnColor * edgeMask), emissionStrength = (edgeMask * _preshader_3), alpha = (burnMask + edgeMask), alphaCutoff = 0.5f, metalness = 0f, roughness = 0.9f, ao = 1f);
}
