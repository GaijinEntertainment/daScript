// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public dissolve_wipe_vertical_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = remap(sin(g_Time * 0.8f),float2(-1f,1f),float2(-0.1f,1.1f));
	let _preshader_1:float const = (_preshader_0 - edgeWidth);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(1f,3f,_preshader_2);
	let n:float const = (mad(noise(inp.worldPos * noiseScale),2f,-1f) * 0.3f);
	let dissolve:float const = (mad(inp.localPos.y,0.5f,0.5f) + n);
	let mask:float const = step(_preshader_0,dissolve);
	let edge:float const = (smooth_step(_preshader_1,_preshader_0,dissolve) - mask);
	return struct<PbrOutput>(albedo = (baseColor * mask), emission = (edge * edgeColor), emissionStrength = (edge * _preshader_3), alpha = (edge + mask), alphaCutoff = 0.5f, metalness = 0f, roughness = 0.8f, ao = 1f);
}
