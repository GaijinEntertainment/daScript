/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public freeze_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_cse_0:float const = -freezeAmount;
	let _preshader_0:float const = (_preshader_cse_0 + 0.9f);
	let _preshader_1:float const = (_preshader_cse_0 + 1.2f);
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.3f,1.2f,_preshader_2);
	let n:float const = noise(inp.worldPos * noiseScale);
	let iceMask:float const = smooth_step(_preshader_0,_preshader_1,n);
	let crystal:float const = (step(0.78f,n) * iceMask);
	return struct<PbrOutput>(albedo = lerp(float3(0.3f,0.3f,0.4f),iceColor,iceMask), emission = mad(iceColor * iceMask,0.2f,crystal * frostColor), emissionStrength = (mad(iceMask,0.3f,crystal) * _preshader_3), metalness = 0f, roughness = lerp(0.8f,0.05f,iceMask), ao = 1f);
}
