// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public shield_hit_3d(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * hitSpeed);
	let _preshader_1:float const = saturate(g_LightDirection.y);
	let _preshader_2:float const = lerp(0.08f,1f,_preshader_1);
	let n:float const = length(inp.localPos);
	let pulse:float const = frac((n * rings) - _preshader_0);
	let ring:float const = (smooth_step(0f,0.5f,pulse) * smooth_step(1f,0.5f,pulse));
	let f:float const = fresnel(fresnel_power,inp.worldNormal,inp.viewDir);
	return struct<PbrOutput>(albedo = float3(0f,0f,0f), emission = mad(hitColor * ring,0.8f,f * shieldColor), emissionStrength = (mad(f,0.3f,ring * 0.4f) * _preshader_2), metalness = 0f, roughness = 0.1f, ao = 1f);
}
