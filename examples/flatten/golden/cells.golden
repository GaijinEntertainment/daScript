/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public cells(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * pulseSpeed);
	let _preshader_1:float3 const = (float3(1f,0f,0.5f) * _preshader_0);
	let _preshader_2:float3 const = (float3(-0.7f,0f,0.3f) * _preshader_0);
	let _preshader_3:float3 const = (float3(0.2f,0f,0.8f) * _preshader_0);
	let _preshader_4:float const = mad(sin(_preshader_0 * 4f),0.15f,0.85f);
	let _preshader_5:float const = saturate(g_LightDirection.y);
	let _preshader_6:float const = lerp(0.1f,0.6f,_preshader_5);
	let _cse_0:float3 const = (cellScale * inp.worldPos);
	let n0:float const = noise(_cse_0 + _preshader_1);
	let n1:float const = noise(mad(_cse_0,2.3f,_preshader_2));
	let n2:float const = noise(mad(_cse_0,0.5f,_preshader_3));
	let n:float const = dot(float3(n0,n1,n2),float3(0.55f,0.25f,0.2f));
	let edgeMask:float const = (smooth_step(0.45f,0.55f,n) - smooth_step(0.55f,0.65f,n));
	let depthMask:float const = smooth_step(0.6f,0.9f,n);
	let innerMask:float const = (smooth_step(0.35f,0.5f,n) * (1f - depthMask));
	let surface:float3 const = lerp(lerp(cellColor,innerColor,innerMask),deepColor,depthMask);
	return struct<PbrOutput>(albedo = surface, emission = ((edgeColor * edgeMask) * _preshader_4), emissionStrength = ((edgeMask * _preshader_4) * _preshader_6), metalness = 0f, roughness = lerp(0.4f,0.8f,depthMask), ao = 1f);
}
