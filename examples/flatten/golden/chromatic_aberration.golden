/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public chromatic_aberration(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = mad(sin(g_Time * 2f),pulse,1f);
	let _preshader_1:float const = (aberration * _preshader_0);
	let _preshader_2:float2 const = float2(_preshader_1,0);
	let _preshader_3:float const = saturate(g_LightDirection.y);
	let _preshader_4:float const = lerp(0.5f,2f,_preshader_3);
	let r:float const = tex2d(albedo_texture,inp.uv + _preshader_2).x;
	let g:float const = tex2d(albedo_texture,inp.uv).y;
	let b:float const = tex2d(albedo_texture,inp.uv - _preshader_2).z;
	let result:float3 const = float3(r,g,b);
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = _preshader_4, metalness = 0f, roughness = 1f, ao = 1f);
}
