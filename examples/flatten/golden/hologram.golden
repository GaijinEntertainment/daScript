/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public hologram(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * scanlineSpeed);
	let _preshader_1:float const = remap(sin(flickerSpeed * g_Time),float2(-1f,1f),float2(0.9f,1f));
	let _preshader_2:float const = saturate(g_LightDirection.y);
	let _preshader_3:float const = lerp(0.08f,1.5f,_preshader_2);
	let scan:float const = frac((inp.worldPos.y * scanlineDensity) - _preshader_0);
	let scanlines:float const = smooth_step(0.3f,0.7f,scan);
	let rim:float const = fresnel(fresnelPower,inp.worldNormal,inp.viewDir);
	let bandIntensity:float const = ((_preshader_1 * scanlines) * 1.5f);
	let rimGlow:float const = (pow(rim,2.5f) * 0.5f);
	let color:float3 const = ((bandIntensity + rimGlow) * hologramColor);
	return struct<PbrOutput>(emission = color, emissionStrength = _preshader_3, albedo = float3(0f,0f,0f), metalness = 0f, roughness = 1f, ao = 1f);
}
