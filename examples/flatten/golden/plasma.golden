/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public plasma(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * speed);
	let _preshader_1:float const = (_preshader_0 * 0.7f);
	let _preshader_2:float const = (_preshader_0 * 0.5f);
	let _preshader_3:float const = saturate(g_LightDirection.y);
	let _preshader_4:float const = lerp(0.5f,2f,_preshader_3);
	let uv:float2 const = (inp.uv * scale);
	let v1:float const = sin(_preshader_0 + uv.x);
	let v2:float const = sin(_preshader_1 + uv.y);
	let v3:float const = sin(_preshader_2 + dot(uv,float2(1f,1f)));
	let v4:float const = sin(length(uv - float2(2f,2f)) - _preshader_0);
	let v:float const = mad(hadd(float4(v1,v2,v3,v4)),0.125f,0.5f);
	let c:float3 const = lerp(colorA,colorB,v);
	let result:float3 const = lerp(c,colorC,mad(sin(v * 3.14159f),0.5f,0.5f));
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = _preshader_4, metalness = 0f, roughness = 1f, ao = 1f);
}
