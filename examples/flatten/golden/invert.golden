/*FULLY INFERRED*/
// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public invert(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = saturate(g_LightDirection.y);
	let _preshader_1:float const = lerp(0.5f,2f,_preshader_0);
	let c:float3 const = tex2d(albedo_texture,inp.uv).xyz;
	let result:float3 const = (float3(1f,1f,1f) - c);
	return struct<PbrOutput>(albedo = result, emission = result, emissionStrength = _preshader_1, metalness = 0f, roughness = 1f, ao = 1f);
}
