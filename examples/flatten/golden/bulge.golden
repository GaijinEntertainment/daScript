// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public bulge(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (1f / radius);
	let center:float2 const = (inp.uv - float2(0.5f,0.5f));
	let dist:float const = length(center);
	let factor:float const = saturate(one_minus(dist * _preshader_0));
	let warp:float const = (1f - ((factor * factor) * strength));
	let uv:float2 const = mad(center,warp,float2(0.5f,0.5f));
	let c:float4 const = tex2d(albedo_texture,uv);
	return struct<PbrOutput>(albedo = c.xyz, alpha = c.w, alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
