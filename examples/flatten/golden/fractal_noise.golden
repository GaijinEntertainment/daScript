// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public fractal_noise(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (g_Time * speed);
	let _preshader_1:float2 const = float2(_preshader_0,_preshader_0 * 0.7f);
	let _preshader_2:float2 const = float2(_preshader_0 * 1.3f,0f);
	let _preshader_3:float const = saturate(g_LightDirection.y);
	let _preshader_4:float const = lerp(0.3f,1.5f,_preshader_3);
	let uv:float2 const = (inp.uv * scale);
	let n1:float const = noise(_preshader_1 + uv);
	let n2:float const = noise(mad(uv,2.1f,_preshader_2));
	let n:float const = mad(n1,0.6f,n2 * 0.4f);
	let result:float3 const = lerp(colorA,colorB,n);
	return struct<PbrOutput>(albedo = result, emission = (n * result), emissionStrength = _preshader_4, metalness = 0f, roughness = 1f, ao = 1f);
}
