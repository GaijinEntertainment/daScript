// [user_scenario][modify_external][access_global]
[export]
[shader_dsl_boost::pixel_shader(flattened:bool=true,packed:bool=true,optimized:bool=true,fused:bool=true,folded:bool=true)]
def public flash(inp:PbrInput const) : PbrOutput {
	let _preshader_0:float const = (mad(sin(flashSpeed * g_Time),0.5f,0.5f) * flashAmount);
	let _preshader_1:float const = saturate(g_LightDirection.y);
	let _preshader_2:float3 const = (flashColor * _preshader_0);
	let _preshader_3:float const = (_preshader_0 * lerp(0.3f,1.5f,_preshader_1));
	let c:float4 const = tex2d(albedo_texture,inp.uv);
	let result:float3 const = lerp(c.xyz,flashColor,_preshader_0);
	return struct<PbrOutput>(albedo = result, emission = _preshader_2, emissionStrength = _preshader_3, alpha = c.w, alphaCutoff = 0.5f, metalness = 0f, roughness = 1f, ao = 1f);
}
