options gen2

require daslib/daspkg

[export]
def package() {
    package_name("storyteller")
    package_description("Storyteller: a tiny story LLM writes on screen while KittenTTS reads it aloud - dasGlfw + dasOpenGL + dasAudio over dasLLAMA")
}

[export]
def release() {
    release_main("main.das")   // one source for the desktop run AND wasm64 (daspkg release wasm)
    release_web_shell("web_shell.html")   // fetches the models into MEMFS, then a click starts the program (audio needs the gesture)
    release_wasm_disable_host_gpu_modules()
}
