        t |> success(default<float16> == float16(0.), "default<>")
    }
    t |> run("ctor and equality") @(t : T?) {
        let a = float16(1.)
        let b = float16(1.)
        let c = float16(2.)
        t |> success(a == b, "a == b")
        t |> success(a != c, "a != c")
    }
    t |> run("copy is value copy") @(t : T?) {
        let a = float16(1.)
        var c = a
        c = float16(5.)
        t |> success(a == float16(1.), "source unchanged")
        t |> success(c == float16(5.), "copy reassigned")
    }
    t |> run("pass and return by value") @(t : T?) {
        let a = float16(1.)
        t |> success(roundtrip_float16(a) == a, "roundtrip")
    }
    t |> run("struct field and layout") @(t : T?) {
        var w = Wrap_float16(pad = uint8(1), v = float16(1.))
        t |> success(w.v == float16(1.), "field read")
        w.v = float16(5.)
        t |> success(w.v == float16(5.), "field write")
        t |> equal(typeinfo sizeof(type<Wrap_float16>), 4)
    }
    t |> run("array element") @(t : T?) {
        var arr <- [float16(1.), float16(5.)]
        t |> equal(length(arr), 2)
        t |> success(arr[0] == float16(1.), "array read 0")
        t |> success(arr[1] == float16(5.), "array read 1")
        delete arr
    }
    t |> run("archive round trip") @(t : T?) {
        var a = float16(1.)
        var data <- mem_archive_save(a)
        var back : float16
        data |> mem_archive_load(back)
        delete data
        t |> success(back == a, "mem archive")
    }
    t |> run("print") @(t : T?) {
        let a = float16(1.)
        let s = "{a}"
        t |> success(!empty(s), "interpolates")
    }
    t |> run("arithmetic") @(t : T?) {
        let a = float16(1.)
        let b = float16(2.)
        t |> success(a + b == float16(3.), "add")
        t |> success(b - a == float16(1.), "sub")
        t |> success(a * b == float16(2.), "mul")
        t |> success(b / a == float16(2.), "div")
        var c = a
        c += b
        t |> success(c == a + b, "add assign")
        c -= b
        t |> success(c == a, "sub assign")
        t |> success(-a == float16(-1.), "unary minus")
    }
    t |> run("converts") @(t : T?) {
        let a = 1.5h
        t |> equal(float(a), 1.5)
        t |> success(float16(1.5) == a, "narrow round trip")
    }
}

struct Wrap_half2 {
    pad : uint8
    v : half2
}

def roundtrip_half2(v : half2) : half2 => v

[test(description = "half2 satisfies the lattice type contract: layout, defaults, equality, copies, indexing, swizzles, archiving and the operators and conversions its family defines")]
def test_half2_conformance(t : T?) {
    t |> run("sizeof and alignof") @(t : T?) {
        t |> equal(typeinfo sizeof(type<half2>), 4)
        t |> equal(typeinfo alignof(type<half2>), 2)
    }
    t |> run("zero init and default") @(t : T?) {
        let z : half2
        t |> success(z == half2(0., 0.), "zero init")
        t |> success(default<half2> == half2(0., 0.), "default<>")
    }
    t |> run("ctor and equality") @(t : T?) {
        let a = half2(1., 2.)
        let b = half2(1., 2.)
        let c = half2(2., 3.)
        t |> success(a == b, "a == b")
        t |> success(a != c, "a != c")
        t |> success(half2(3.) == half2(3., 3.), "splat ctor")
    }
    t |> run("copy is value copy") @(t : T?) {
        let a = half2(1., 2.)
        var c = a
        c = half2(5., 6.)
        t |> success(a == half2(1., 2.), "source unchanged")
        t |> success(c == half2(5., 6.), "copy reassigned")
    }
    t |> run("pass and return by value") @(t : T?) {
        let a = half2(1., 2.)
        t |> success(roundtrip_half2(a) == a, "roundtrip")
    }
    t |> run("index read and write") @(t : T?) {
        var a = half2(1., 2.)
        t |> equal(a[0], 1h)
        t |> equal(a[1], 2h)
        a[1] = 9h
        t |> equal(a[1], 9h)
    }
    t |> run("swizzle") @(t : T?) {
        var a = half2(1., 2.)
        t |> equal(a.x, 1h)
        t |> equal(a.y, 2h)
        t |> success(a.yx == half2(2., 1.), "reverse read")
        a.y = 9h
        t |> equal(a.y, 9h)
        a.xy = half2(7., 8.)
        t |> equal(a.x, 7h)
        t |> equal(a.y, 8h)
    }
    t |> run("s-namespace swizzle") @(t : T?) {
        var a = half2(1., 2.)
        t |> equal(a.s1, 2h)
        t |> success(a.s10 == half2(2., 1.), "pair reorder")
        a.s0 = 9h
        t |> equal(a.s0, 9h)
    }
    t |> run("struct field and layout") @(t : T?) {
        var w = Wrap_half2(pad = uint8(1), v = half2(1., 2.))
        t |> success(w.v == half2(1., 2.), "field read")
        w.v = half2(5., 6.)
        t |> success(w.v == half2(5., 6.), "field write")
        t |> equal(typeinfo sizeof(type<Wrap_half2>), 6)
    }
    t |> run("array element") @(t : T?) {
        var arr <- [half2(1., 2.), half2(5., 6.)]
        t |> equal(length(arr), 2)
        t |> success(arr[0] == half2(1., 2.), "array read 0")
        t |> success(arr[1] == half2(5., 6.), "array read 1")
        delete arr
    }
    t |> run("archive round trip") @(t : T?) {
        var a = half2(1., 2.)
        var data <- mem_archive_save(a)
        var back : half2
        data |> mem_archive_load(back)
        delete data
        t |> success(back == a, "mem archive")
    }
    t |> run("print") @(t : T?) {
        let a = half2(1., 2.)
        let s = "{a}"
        t |> success(!empty(s), "interpolates")
    }
    t |> run("arithmetic") @(t : T?) {
        let a = half2(1., 2.)
        let b = half2(2., 4.)
        t |> success(a + b == half2(3., 6.), "add")
        t |> success(b - a == half2(1., 2.), "sub")
        t |> success(a * b == half2(2., 8.), "mul")
        t |> success(b / a == half2(2., 2.), "div")
        var c = a
        c += b
        t |> success(c == a + b, "add assign")
        c -= b
        t |> success(c == a, "sub assign")
        t |> success(-a == half2(-1., -2.), "unary minus")
        t |> success(a * 2h == a + a, "vec mul scalar")
        t |> success(2h * a == a + a, "scalar mul vec")
        t |> success((a + a) / 2h == a, "vec div scalar")
        c = a
        c *= 2h
        t |> success(c == a + a, "mul assign scalar")
    }
    t |> run("converts") @(t : T?) {
        let a = half2(1., 2.)
        let f = float2(a)
        t |> success(f == float2(1., 2.), "widen to float")
        t |> success(half2(f) == a, "narrow round trip")
    }
}

