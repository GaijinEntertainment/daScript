        t |> success(a.xy == uint2(1u, 2u), "pair read")
        a.w = 9u
        t |> equal(a.w, 9u)
        a.xy = uint2(7u, 8u)
        t |> equal(a.x, 7u)
        t |> equal(a.y, 8u)
    }
    t |> run("s-namespace swizzle") @(t : T?) {
        var a = uint4(1u, 2u, 3u, 4u)
        t |> equal(a.s3, 4u)
        t |> success(a.s30 == uint2(4u, 1u), "pair reorder")
        a.s0 = 9u
        t |> equal(a.s0, 9u)
    }
    t |> run("struct field and layout") @(t : T?) {
        var w = Wrap_uint4(pad = uint8(1), v = uint4(1u, 2u, 3u, 4u))
        t |> success(w.v == uint4(1u, 2u, 3u, 4u), "field read")
        w.v = uint4(5u, 6u, 7u, 8u)
        t |> success(w.v == uint4(5u, 6u, 7u, 8u), "field write")
        t |> equal(typeinfo sizeof(type<Wrap_uint4>), 20)
    }
    t |> run("array element") @(t : T?) {
        var arr <- [uint4(1u, 2u, 3u, 4u), uint4(5u, 6u, 7u, 8u)]
        t |> equal(length(arr), 2)
        t |> success(arr[0] == uint4(1u, 2u, 3u, 4u), "array read 0")
        t |> success(arr[1] == uint4(5u, 6u, 7u, 8u), "array read 1")
        delete arr
    }
    t |> run("archive round trip") @(t : T?) {
        var a = uint4(1u, 2u, 3u, 4u)
        var data <- mem_archive_save(a)
        var back : uint4
        data |> mem_archive_load(back)
        delete data
        t |> success(back == a, "mem archive")
    }
    t |> run("print") @(t : T?) {
        let a = uint4(1u, 2u, 3u, 4u)
        let s = "{a}"
        t |> success(!empty(s), "interpolates")
    }
    t |> run("arithmetic") @(t : T?) {
        let a = uint4(1u, 2u, 3u, 4u)
        let b = uint4(2u, 4u, 6u, 8u)
        t |> success(a + b == uint4(3u, 6u, 9u, 12u), "add")
        t |> success(b - a == uint4(1u, 2u, 3u, 4u), "sub")
        t |> success(a * b == uint4(2u, 8u, 18u, 32u), "mul")
        var c = a
        c += b
        t |> success(c == a + b, "add assign")
        c -= b
        t |> success(c == a, "sub assign")
        t |> success(a * 2u == a + a, "vec mul scalar")
        t |> success(2u * a == a + a, "scalar mul vec")
        c = a
        c *= 2u
        t |> success(c == a + a, "mul assign scalar")
    }
    t |> run("shift right") @(t : T?) {
        let a = uint4(200u, 203u, 206u, 209u)
        t |> success(a >> 2 == uint4(50u, 50u, 51u, 52u), "logical shift")
        t |> success(a >> 34 == a >> 2, "count masks to lane width")
        t |> success(a >> 0 == a, "shift by zero")
        var c = a
        c >>= 2
        t |> success(c == a >> 2, "shift right assign")
    }
    t |> run("shift left") @(t : T?) {
        let a = uint4(200u, 203u, 206u, 209u)
        t |> success(a << 2 == uint4(800u, 812u, 824u, 836u), "lanes wrap")
        t |> success(a << 34 == a << 2, "count masks to lane width")
        var c = a
        c <<= 2
        t |> success(c == a << 2, "shift left assign")
    }
    t |> run("bitwise") @(t : T?) {
        let a = uint4(200u, 203u, 206u, 209u)
        let b = uint4(45u, 50u, 55u, 60u)
        t |> success((a & b) == uint4(8u, 2u, 6u, 16u), "and")
        t |> success((a | b) == uint4(237u, 251u, 255u, 253u), "or")
        t |> success((a ^ b) == uint4(229u, 249u, 249u, 237u), "xor")
        var c = a
        c &= b
        t |> success(c == (a & b), "and assign")
        c = a
        c |= b
        t |> success(c == (a | b), "or assign")
        c = a
        c ^= b
        t |> success(c == (a ^ b), "xor assign")
    }
}

struct Wrap_int8 {
    pad : uint8
    v : int8
}

def roundtrip_int8(v : int8) : int8 => v

[test(description = "int8 satisfies the lattice type contract: layout, defaults, equality, copies, indexing, swizzles, archiving and the operators and conversions its family defines")]
def test_int8_conformance(t : T?) {
    t |> run("sizeof and alignof") @(t : T?) {
        t |> equal(typeinfo sizeof(type<int8>), 1)
        t |> equal(typeinfo alignof(type<int8>), 1)
    }
    t |> run("zero init and default") @(t : T?) {
        let z : int8
        t |> success(z == int8(0), "zero init")
        t |> success(default<int8> == int8(0), "default<>")
    }
    t |> run("ctor and equality") @(t : T?) {
        let a = int8(1)
        let b = int8(1)
        let c = int8(2)
        t |> success(a == b, "a == b")
        t |> success(a != c, "a != c")
    }
    t |> run("copy is value copy") @(t : T?) {
        let a = int8(1)
        var c = a
        c = int8(5)
        t |> success(a == int8(1), "source unchanged")
        t |> success(c == int8(5), "copy reassigned")
    }
    t |> run("pass and return by value") @(t : T?) {
        let a = int8(1)
        t |> success(roundtrip_int8(a) == a, "roundtrip")
    }
    t |> run("struct field and layout") @(t : T?) {
        var w = Wrap_int8(pad = uint8(1), v = int8(1))
        t |> success(w.v == int8(1), "field read")
        w.v = int8(5)
        t |> success(w.v == int8(5), "field write")
        t |> equal(typeinfo sizeof(type<Wrap_int8>), 2)
    }
    t |> run("array element") @(t : T?) {
        var arr <- [int8(1), int8(5)]
        t |> equal(length(arr), 2)
        t |> success(arr[0] == int8(1), "array read 0")
        t |> success(arr[1] == int8(5), "array read 1")
        delete arr
    }
    t |> run("archive round trip") @(t : T?) {
        var a = int8(1)
        var data <- mem_archive_save(a)
        var back : int8
        data |> mem_archive_load(back)
        delete data
        t |> success(back == a, "mem archive")
    }
    t |> run("print") @(t : T?) {
        let a = int8(1)
        let s = "{a}"
        t |> success(!empty(s), "interpolates")
    }
}

