}

def roundtrip_float16(v : float16) : float16 => v

[test(description = "float16 satisfies the lattice type contract: layout, defaults, equality, copies, indexing, swizzles, archiving and the operators and conversions its family defines")]
def test_float16_conformance(t : T?) {
    t |> run("sizeof and alignof") @(t : T?) {
        t |> equal(typeinfo sizeof(type<float16>), 2)
        t |> equal(typeinfo alignof(type<float16>), 2)
    }
    t |> run("zero init and default") @(t : T?) {
        let z : float16
