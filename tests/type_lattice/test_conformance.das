    pad : uint8
    v : half4
}

def roundtrip_half4(v : half4) : half4 => v

[test(description = "half4 satisfies the lattice type contract: layout, defaults, equality, copies, indexing, swizzles, archiving and the operators and conversions its family defines")]
def test_half4_conformance(t : T?) {
    t |> run("sizeof and alignof") @(t : T?) {
        t |> equal(typeinfo sizeof(type<half4>), 8)
        t |> equal(typeinfo alignof(type<half4>), 2)
    }
    t |> run("zero init and default") @(t : T?) {
