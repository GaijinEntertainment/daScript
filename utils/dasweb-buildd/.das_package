options gen2

require daslib/daspkg

[export]
def package() {
    package_name("dasweb-buildd")
    package_description("dasweb wasm build worker: pulls the dasweb-playground build queue, runs sandboxed wasm builds, uploads artifacts")
}

[export]
def release() {
    release_main("main.das")
    release_name("dasweb-buildd")
    release_include_if_missing("dasweb-buildd.toml")   // initialize once; preserve deployed edits on upgrades
    release_include_from("utils/watchdog/watchdog.py")
    release_include_if_missing("watchdog.json")
    release_include("run_build.sh")                    // the sandboxed build recipe the service invokes
}
