options gen2
options indenting = 4
options no_unused_function_arguments = false

require dastest/testing_boost public

require strings
require daslib/fio

// Every citation this file PLANTS is assembled from `ANN` rather than spelled out: the extractor
// reads source the way LINT026's forward pass does, so a citation spelled out in a string literal
// below would be a citation made by this file, against a document utils/internal/arch-extract/tests does
// not carry.

let ANN = "arch"

var private _tmp_dir : string
var private _tmp_dir_inited = false


def private tmp_root() : string {
    if (!_tmp_dir_inited) {
        let r = create_temp_directory_result("arch_extract_test")
        // Fail-fast: an empty path would resolve against the working directory and plant the
        // fixture tree in the worktree.
        if (!(r is value)) {
            panic("could not create temp dir for the arch-extract test: {unsafe(r.error)}")
        }
        _tmp_dir = unsafe(r.value)
        _tmp_dir_inited = true
    }
    return _tmp_dir
}


[finalize]
def cleanup_temp_dir {
    if (_tmp_dir_inited && !empty(_tmp_dir)) {
        rmdir_rec(_tmp_dir)
    }
}


// One `[arch]` citation to plant, and the function that carries it.
struct private Cite {
    doc : string
    anchor : string
    fn : string
}


def private plant(dir, name, content : string) {
    fopen(path_join(dir, name), "wb") $(f) {
        if (f != null) {
            fwrite(f, content)
        }
    }
}


def private plant_code(dir, name : string; cites : array<Cite>) {
    plant(dir, name, build_string() $(var w) {
        w |> write("options gen2\n\n")
        for (c in cites) {
            w |> write("[{ANN}(at=\"{c.doc}#{c.anchor}\")]\ndef {c.fn} \{\n\}\n\n")
        }
        w |> write("[export]\ndef main \{\n")
        for (c in cites) {
            w |> write("    {c.fn}();\n")
        }
        w |> write("\}\n")
    })
}


// A .md declaring `anchors`, one heading each, a recognizable body line per section.
def private plant_doc(dir, name : string; anchors : array<string>) {
    plant(dir, name, build_string() $(var w) {
        w |> write("# {name}\n\n")
        for (a in anchors) {
            w |> write("## Section {a} \{#{a}\}\nbody of {a}\n\n")
        }
    })
}


// argv[0] is the running interpreter - dastest itself is spawned as
// `daslang(.exe) dastest/dastest.das ...`, so it names the binary to spawn.
def private das_exe() : string {
    let args <- get_command_line_arguments()
    return empty(args) ? "" : args[0]
}


def private run_extract(root, out_dir, base : string; scans : array<string>; var output : string&) : int {
    var argv <- [das_exe(), "-dasroot", get_das_root(),
                 "{get_das_root()}/utils/internal/arch-extract/main.das", "--",
                 "--out", out_dir, "--root", root, "--base", base]
    argv |> push_from(scans)
    return unsafe(popen_argv(argv, 0.0, $(f) {
        if (f != null) {
            output = fread(f)
        }
    }))
}


// root/base/lib/code.das cites its own folder's document and the base root's; the base root
// document also declares an anchor nothing cites.
def private build_tree(name : string) : string {
    let root = path_join(tmp_root(), name)
    let base = path_join(root, "base")
    let lib = path_join(base, "lib")
    mkdir_rec(lib)
    plant_doc(base, "ARCHITECTURE.md", ["alpha", "orphan"])
    plant_doc(lib, "ARCHITECTURE.md", ["local"])
    plant_code(lib, "code.das", [Cite(doc = "../ARCHITECTURE.md", anchor = "alpha", fn = "up"),
                                 Cite(doc = "ARCHITECTURE.md", anchor = "local", fn = "near")])
    return root
}


[test]
def test_extraction(t : T?) {
    t |> run("cited sections are excerpted verbatim, uncited ones are not") @(t : T?) {
        let root = build_tree("basic")
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base/lib"], out)
        t |> equal(rc, 0, "clean tree extracts cleanly\n{out}")
        let up_doc = fread(path_join(out_dir, "base/ARCHITECTURE.md"))
        t |> success(up_doc |> starts_with("<!-- GENERATED by arch-extract"),
            "the excerpt opens with the generated banner\n{up_doc}")
        t |> success(find(up_doc, "## Section alpha \{#alpha\}") >= 0, "the cited heading survives with its anchor\n{up_doc}")
        t |> success(find(up_doc, "body of alpha") >= 0, "the cited section's body survives\n{up_doc}")
        t |> success(find(up_doc, "orphan") < 0, "the uncited section does not ship\n{up_doc}")
        let near_doc = fread(path_join(out_dir, "base/lib/ARCHITECTURE.md"))
        t |> success(find(near_doc, "body of local") >= 0, "the same-folder document is excerpted at its own path\n{near_doc}")
    }
    t |> run("sections land in document order, not citation order") @(t : T?) {
        let root = path_join(tmp_root(), "order")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(base, "ARCHITECTURE.md", ["first", "second"])
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "second", fn = "a"),
                                      Cite(doc = "ARCHITECTURE.md", anchor = "first", fn = "b")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "clean tree extracts cleanly\n{out}")
        let doc = fread(path_join(out_dir, "base/ARCHITECTURE.md"))
        // both presences first: find() returns -1 for a dropped section, which would
        // satisfy the order comparison vacuously
        t |> success(find(doc, "\{#first\}") >= 0, "the first cited section is present\n{doc}")
        t |> success(find(doc, "\{#second\}") >= 0, "the second cited section is present\n{doc}")
        t |> success(find(doc, "\{#first\}") < find(doc, "\{#second\}"),
            "the excerpt keeps the source document's order\n{doc}")
    }
    t |> run("a citation-free tree still yields the base folder, and nothing else") @(t : T?) {
        let root = path_join(tmp_root(), "empty")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant(base, "code.das", "options gen2\n\n[export]\ndef main \{\n\}\n")
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "no citations is a clean run\n{out}")
        let st = stat(path_join(out_dir, "base"))
        t |> success(st.is_valid && st.is_dir, "the base folder exists for install(DIRECTORY)\n{out}")
        let doc = stat(path_join(out_dir, "base/ARCHITECTURE.md"))
        t |> success(!doc.is_valid, "and carries no document\n{out}")
    }
}


[test]
def test_nested_sections(t : T?) {
    t |> run("a cited anchor nested inside a cited section is on the page once") @(t : T?) {
        let root = path_join(tmp_root(), "nested")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant(base, "ARCHITECTURE.md", build_string() $(var w) {
            w |> write("# doc\n\n")
            w |> write("## Parent \{#parent\}\nparent body\n\n")
            w |> write("### Child \{#child\}\nchild body\n\n")
            w |> write("## Next \{#next\}\nnext body\n\n")
        })
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "parent", fn = "a"),
                                      Cite(doc = "ARCHITECTURE.md", anchor = "child", fn = "b")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "clean tree extracts cleanly\n{out}")
        let doc = fread(path_join(out_dir, "base/ARCHITECTURE.md"))
        var hits = 0
        var from = 0
        while (true) {
            let at = find(doc, "\{#child\}", from)
            break if (at < 0)
            hits ++
            from = at + 1
        }
        t |> equal(hits, 1, "the nested anchor is declared exactly once\n{doc}")
        t |> success(find(doc, "child body") >= 0, "and its section rides inside the parent's\n{doc}")
    }
    t |> run("re-extraction drops an excerpt whose last citation is gone") @(t : T?) {
        let root = path_join(tmp_root(), "stale")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(base, "ARCHITECTURE.md", ["alpha"])
        plant_doc(base, "ARCHITECTURE_OLD.md", ["beta"])
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "alpha", fn = "a"),
                                      Cite(doc = "ARCHITECTURE_OLD.md", anchor = "beta", fn = "b")])
        let out_dir = path_join(root, "out")
        var out : string
        t |> equal(run_extract(root, out_dir, "base", ["base"], out), 0, "first extraction is clean\n{out}")
        t |> success(stat(path_join(out_dir, "base/ARCHITECTURE_OLD.md")).is_valid, "both excerpts exist\n{out}")
        // the last citation to ARCHITECTURE_OLD.md goes away; the OUT DIR is incremental state
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "alpha", fn = "a")])
        var again : string
        t |> equal(run_extract(root, out_dir, "base", ["base"], again), 0, "re-extraction is clean\n{again}")
        t |> success(!stat(path_join(out_dir, "base/ARCHITECTURE_OLD.md")).is_valid,
            "the stale excerpt is gone - install(DIRECTORY) must not package it\n{again}")
        t |> success(stat(path_join(out_dir, "base/ARCHITECTURE.md")).is_valid, "the live excerpt survives\n{again}")
    }
    t |> run("a commented-out citation is not a citation") @(t : T?) {
        let root = path_join(tmp_root(), "commented")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant(base, "code.das", build_string() $(var w) {
            w |> write("options gen2\n\n")
            w |> write("// [{ANN}(at=\"GONE.md#vanished\")]\n")
            w |> write("[export]\ndef main \{\n\}\n")
        })
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "a `//` line is prose, not a citation\n{out}")
    }
}


[test]
def test_scan_edges(t : T?) {
    t |> run("the scan recurses into subfolders of a scan root") @(t : T?) {
        let root = path_join(tmp_root(), "recurse")
        let base = path_join(root, "base")
        let lib = path_join(base, "lib")
        mkdir_rec(lib)
        plant_doc(lib, "ARCHITECTURE.md", ["deep"])
        plant_code(lib, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "deep", fn = "d")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "the walk reaches base/lib from base\n{out}")
        let doc = fread(path_join(out_dir, "base/lib/ARCHITECTURE.md"))
        t |> success(find(doc, "body of deep") >= 0, "the nested folder's citation is extracted\n{doc}")
    }
    t |> run("a cited document above --root fails the run") @(t : T?) {
        let outer = path_join(tmp_root(), "rootcage")
        let root = path_join(outer, "root")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(outer, "ARCHITECTURE.md", ["up"])
        plant_code(base, "code.das", [Cite(doc = "../../ARCHITECTURE.md", anchor = "up", fn = "u")])
        let out_dir = path_join(outer, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> success(rc != 0, "an ancestor document beyond the root tree is an error\n{out}")
        t |> success(find(out, "outside the root tree") >= 0, "named as the root violation\n{out}")
    }
    t |> run("builtin.das is outside the citation system - its citations neither extract nor fail") @(t : T?) {
        let root = path_join(tmp_root(), "builtin")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(base, "ARCHITECTURE.md", ["alpha"])
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "alpha", fn = "a")])
        plant_code(base, "builtin.das", [Cite(doc = "GONE.md", anchor = "nope", fn = "b")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> equal(rc, 0, "the dangling citation in builtin.das is not scanned - LINT026's walk skips it too\n{out}")
    }
    t |> run("a scan folder that is not a directory fails the run") @(t : T?) {
        let root = path_join(tmp_root(), "badscan")
        mkdir_rec(root)
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["missing"], out)
        t |> success(rc != 0, "a missing scan root is an error\n{out}")
        t |> success(find(out, "not a directory") >= 0, "named as the scan-folder violation\n{out}")
    }
}


[test]
def test_failures(t : T?) {
    t |> run("a dangling citation fails the run and writes nothing") @(t : T?) {
        let root = path_join(tmp_root(), "dangling")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(base, "ARCHITECTURE.md", ["alpha"])
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "nope", fn = "bad")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> success(rc != 0, "the unresolved citation fails the run\n{out}")
        t |> success(find(out, "no such anchor") >= 0, "in LINT026's words\n{out}")
        let st = stat(path_join(out_dir, "base/ARCHITECTURE.md"))
        t |> success(!st.is_valid, "a broken tree produces no output for install to copy\n{out}")
    }
    t |> run("a cited document outside --base fails the run") @(t : T?) {
        let root = path_join(tmp_root(), "outside")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(root, "ARCHITECTURE.md", ["above"])
        plant_code(base, "code.das", [Cite(doc = "../ARCHITECTURE.md", anchor = "above", fn = "up")])
        let out_dir = path_join(root, "out")
        var out : string
        let rc = run_extract(root, out_dir, "base", ["base"], out)
        t |> success(rc != 0, "a document the install subtree cannot carry is an error\n{out}")
        t |> success(find(out, "outside --base") >= 0, "named as the base violation\n{out}")
    }
    t |> run("negative control - pointing the citation at a declared anchor clears the failure") @(t : T?) {
        let root = path_join(tmp_root(), "control")
        let base = path_join(root, "base")
        mkdir_rec(base)
        plant_doc(base, "ARCHITECTURE.md", ["alpha"])
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "nope", fn = "only")])
        let out_dir = path_join(root, "out")
        var broken : string
        t |> success(run_extract(root, out_dir, "base", ["base"], broken) != 0, "the dangling citation fails\n{broken}")
        plant_code(base, "code.das", [Cite(doc = "ARCHITECTURE.md", anchor = "alpha", fn = "only")])
        var fixed : string
        let rc = run_extract(root, out_dir, "base", ["base"], fixed)
        t |> equal(rc, 0, "the same citation, resolving, extracts\n{fixed}")
        let doc = fread(path_join(out_dir, "base/ARCHITECTURE.md"))
        t |> success(find(doc, "body of alpha") >= 0, "and the section ships\n{doc}")
    }
}
