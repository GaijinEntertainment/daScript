options gen2
options indenting = 4

// Extracts, for a shipped source tree, the architecture-document sections its [arch]
// annotations cite, into an output tree the SDK install rules copy beside the shipped code.
// The rule documents themselves never install, but a shipped citation must still resolve, so
// the bundle carries a generated excerpt - the cited sections verbatim, nothing else - and
// LINT026 stays armed in an installed SDK. Resolution semantics are the shared scanner's
// (utils/common/arch_citations.das): a section this tool extracts is exactly what lint
// accepts, and a citation it rejects is one lint reports.

require daslib/fio
require daslib/clargs
require strings
require daslib/strings_boost
require ../../common/arch_citations.das


// The leak gates (root CMakeLists install(CODE) and ci/smoke_test_bundle.sh) recognize a
// generated excerpt by this first-line prefix - a rule document without it never installs.
let GENERATED_BANNER_PREFIX = "<!-- GENERATED by arch-extract"


[CommandLineArgs]
struct Config {
    @clarg_required
    @clarg_doc = "Output root; each generated document lands at its root-relative path beneath it"
    @clarg_path
    out : string

    @clarg_doc = "Tree citations resolve within (default: the interpreter's dasroot)"
    @clarg_path
    root : string

    @clarg_required
    @clarg_doc = "Root-relative folder every cited document must fall under - the subtree the caller installs"
    base : string

    @clarg_positional
    @clarg_doc = "Root-relative folders whose .das files are scanned for [arch] citations"
    scan : array<string>
}


def private scan_das_files(path : string; var out : array<string>) {
    fio::dir(path) $(name) {
        return if (arch_walk_skips(name))
        let full = path_join(path, name)
        let st = stat(full)
        return if (!st.is_valid)
        if (st.is_dir) {
            scan_das_files(full, out)
        } elif (st.is_reg && name |> ends_with(".das")) {
            out |> push(full)
        }
    }
}


def private write_text(path, content : string) : bool {
    var ok = false
    fopen(path, "wb") $(f) {
        if (f != null) {
            fwrite(f, content)
            ok = true
        }
    }
    return ok
}


// Every resolved citation lands in `citedDocs` / `citedAnchors`; every unresolved one is
// reported and counted. Returns the failure count.
def private collect_cited(files : array<string>; var citedDocs, citedAnchors : table<string; void?>; var citations : int&) : int {
    var docs : ArchDocs
    var failures = 0
    for (f in files) {
        let text = fread(f)
        continue if (empty(text) || find(text, "arch") < 0)
        for (c in collect_arch_citations(f, text)) {
            let reason = citation_failure_reason(docs, f, c)
            if (!empty(reason)) {
                to_log(LOG_ERROR, "{f}:{c.line}: [arch] citation does not resolve - {reason} (\"{c.raw}\")\n")
                failures ++
                continue
            }
            citations ++
            citedDocs |> insert(c.doc, null)
            citedAnchors |> insert("{c.doc}#{c.anchor}", null)
        }
    }
    return failures
}


// Writes one excerpt: the banner line, then the cited sections in DOCUMENT order, so the
// excerpt reads as the source doc does. A cited anchor nested inside an already-emitted
// section is on the page once - emitting its section again would declare the anchor twice,
// which LINT026 reports as ambiguous. Returns the section count, negative on failure.
def private emit_excerpt(doc, rel, outPath : string; citedAnchors : table<string; void?>) : int {
    var sections = 0
    let content = build_string() $(var w) {
        w |> write("{GENERATED_BANNER_PREFIX} - the [arch]-cited sections of {rel}; the full document lives in the daslang repository and does not install. -->\n")
        var emittedEnd = 0
        for (a in collect_md_anchors(doc)) {
            continue if (!(citedAnchors |> key_exists("{doc}#{a.name}")))
            let span = section_span(doc, a.name)
            continue if (span.x < emittedEnd)
            emittedEnd = span.y
            w |> write("\n")
            w |> write(section_text(doc, a.name))
            sections ++
        }
    }
    mkdir_rec(dir_name(outPath))
    if (!write_text(outPath, content)) {
        to_log(LOG_ERROR, "error: could not write {outPath}\n")
        return -1
    }
    return sections
}


[export]
def main : int {
    var r <- parse_args(type<Config>)
    if (r |> is_err) {
        to_log(LOG_ERROR, "error: {r |> unwrap_err}\n")
        print_help(get_command_info(type<Config>), "utils/internal/arch-extract/main.das")
        return 1
    }
    let cfg <- r |> move_unwrap
    if (empty(cfg.scan)) {
        to_log(LOG_ERROR, "error: no scan folders given\n")
        return 1
    }
    let root = arch_path(empty(cfg.root) ? get_das_root() : cfg.root)
    var files : array<string>
    for (scanRel in cfg.scan) {
        let dir = "{root}/{scanRel}"
        let st = stat(dir)
        if (!st.is_valid || !st.is_dir) {
            to_log(LOG_ERROR, "error: scan folder is not a directory: {dir}\n")
            return 1
        }
        scan_das_files(dir, files)
    }
    files |> sort

    var citedDocs : table<string; void?>
    var citedAnchors : table<string; void?>
    var citations = 0
    let failures = collect_cited(files, citedDocs, citedAnchors, citations)
    if (failures > 0) {
        to_log(LOG_ERROR, "arch-extract: {failures} unresolved citation(s) - nothing written\n")
        return 1
    }

    var docList <- [for (d in keys(citedDocs)); d]
    docList |> sort

    // the output dir is incremental state: an excerpt whose last citation is gone must not
    // survive into install(DIRECTORY), so the generated base tree is rebuilt from nothing -
    // and only now, after validation, so a failing run leaves the previous output intact.
    // The empty base folder also gives a citation-free tree's install(DIRECTORY) something
    // to copy.
    rmdir_rec(path_join(cfg.out, cfg.base))
    mkdir_rec(path_join(cfg.out, cfg.base))
    var sections = 0
    for (doc in docList) {
        if (!(doc |> starts_with("{root}/"))) {
            to_log(LOG_ERROR, "error: cited document is outside the root tree: {doc}\n")
            return 1
        }
        let rel = slice(doc, length(root) + 1)
        if (!(rel |> starts_with("{cfg.base}/"))) {
            to_log(LOG_ERROR, "error: cited document is outside --base {cfg.base}: {rel}\n")
            return 1
        }
        let n = emit_excerpt(doc, rel, path_join(cfg.out, rel), citedAnchors)
        return 1 if (n < 0)
        sections += n
    }
    to_log(LOG_INFO, "arch-extract: {length(docList)} document(s), {sections} section(s), {citations} citation(s) from {length(files)} scanned file(s)\n")
    return 0
}
