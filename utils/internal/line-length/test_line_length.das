options gen2
options indenting = 4

require dastest/testing_boost public

require strings
require daslib/strings_boost
require daslib/fio
require daslib/command_line
require line_length

def private kinds(path, text : string; added : array<int>) : array<string> => <- [
    for (f in find_violations(path, text, added));
        "{f.line}:{slice(f.message, 0, find(f.message, " "))}"]

def private kinds(path, text : string) : array<string> => <- kinds(path, text, all_lines(text))

let LONG_COMMENT = repeat("x", COMMENT_LIMIT + 1)
let LONG_CODE = repeat("y", CODE_LIMIT + 1)

[test]
def test_code_width(t : T?) {
    t |> run("over the limit") @(t : T?) {
        t |> equal(kinds("a.das", "let s = \"{LONG_CODE}\"\n"), ["1:line"])
    }
    t |> run("at the limit") @(t : T?) {
        t |> equal(length(kinds("a.das", repeat("z", CODE_LIMIT))), 0)
    }
    t |> run("a tab counts as TAB_WIDTH columns") @(t : T?) {
        t |> equal(kinds("a.das", "\t" + repeat("z", CODE_LIMIT - TAB_WIDTH + 1)), ["1:line"])
    }
    t |> run("a multi-byte character is one column") @(t : T?) {
        t |> equal(length(kinds("a.das", repeat("\u00e9", CODE_LIMIT))), 0)
    }
    t |> run("only added lines are measured") @(t : T?) {
        let text = "{LONG_CODE}\nok\n"
        t |> equal(length(kinds("a.das", text, [2])), 0)
        t |> equal(kinds("a.das", text, [1]), ["1:line"])
    }
}

[test]
def test_comment_width(t : T?) {
    t |> run("line comment") @(t : T?) {
        t |> equal(kinds("a.das", "// {LONG_COMMENT}\n"), ["1:comment"])
    }
    t |> run("indentation does not count") @(t : T?) {
        let text = repeat(" ", 20) + "// " + repeat("z", COMMENT_LIMIT - 3)
        t |> equal(length(kinds("a.das", text)), 0)
    }
    t |> run("trailing comment is measured from its marker") @(t : T?) {
        let fits = "var a = 0" + repeat(" ", 20) + "// " + repeat("z", 60)
        t |> equal(length(kinds("a.das", fits)), 0)
        t |> equal(kinds("a.das", "var a = 0 // {LONG_COMMENT}\n"), ["1:comment"])
    }
    t |> run("block comment continuation lines") @(t : T?) {
        t |> equal(kinds("a.das", "/*\n   {LONG_COMMENT}\n*/\nvar a = 0\n"), ["2:comment"])
    }
    t |> run("nested block comments") @(t : T?) {
        let text = "/* /* */\n{LONG_COMMENT}\n*/\n{LONG_COMMENT}\n"
        t |> equal(kinds("a.das", text), ["2:comment"])
    }
}

[test]
def test_lexing(t : T?) {
    t |> run("a comment marker inside a string is code") @(t : T?) {
        let url = "https://" + repeat("z", COMMENT_LIMIT)
        t |> equal(length(kinds("a.das", "let u = \"{url}\"\n")), 0)
    }
    t |> run("interpolation holding a string") @(t : T?) {
        let text = "let s = \"x \{\"//\"\} {repeat("z", COMMENT_LIMIT)}\"\n"
        t |> equal(length(kinds("a.das", text)), 0)
    }
    t |> run("a quote character literal does not open a string") @(t : T?) {
        t |> equal(kinds("a.das", "let q = '\"' // {LONG_COMMENT}\n"), ["1:comment"])
    }
}

[test]
def test_skips(t : T?) {
    t |> run("non-das files") @(t : T?) {
        t |> equal(length(kinds("a.cpp", LONG_CODE)), 0)
    }
    t |> run("generated files") @(t : T?) {
        t |> equal(length(kinds("a.das", "// generated by gen.das\n{LONG_CODE}\n")), 0)
    }
}

[test]
def test_diff_base(t : T?) {
    t |> equal(diff_base("", "master"), "origin/master", "no --base: the remote's branch")
    t |> equal(diff_base("HEAD~1", "master"), "HEAD~1", "--base is used as given")
    t |> equal(diff_base("upstream/main", "master"), "upstream/main", "another remote stays")
}

[test]
def test_untracked(t : T?) {
    t |> equal(untracked_paths("a/new.das\r\nnotes.md\n\nb.das\n"), ["a/new.das", "b.das"],
        "only .das files, blank lines and CR dropped")
    t |> equal(all_lines("x\ny"), [1, 2], "a final line without a newline counts")
    t |> equal(all_lines("x\ny\n"), [1, 2, 3], "the empty tail after a final newline is a line")
}

def private write_at(t : T?; root, rel, text : string) {
    t |> success(fwrite(path_join(root, rel), text), "wrote {rel}")
}

def private run_in(cwd : string; args : array<string>) : tuple<rc : int; out : string> {
    let noenv : array<string>
    var out : string
    let rc = run_and_capture(args, cwd, noenv, out, 120.0)
    return (rc = rc, out = out)
}

[test]
def test_untracked_files_are_checked(t : T?) {
    let made = create_temp_directory_result("line_length_repo")
    if (!(made is value)) {
        t |> skip("no temp dir: {unsafe(made.error)}")
        return
    }
    let repo = unsafe(made.value)
    let git = run_in(repo, ["git", "init", "-q"])
    if (git.rc != 0) {
        t |> skip("git init unavailable: {git.out}")
        return
    }
    let long_file = "options gen2\nlet s = \"{LONG_CODE}\"\n"
    write_at(t, repo, "ok.das", "options gen2\n")
    run_in(repo, ["git", "add", "ok.das"])
    run_in(repo, ["git", "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "-m", "init"])
    write_at(t, repo, "long.das", long_file)
    write_at(t, repo, ".gitignore", "skip.das\n")
    write_at(t, repo, "skip.das", long_file)
    let main_das = get_full_file_name("utils/internal/line-length/main.das")
    let run = run_in(repo, [get_das_exe(), main_das, "--", "--base", "HEAD"])
    t |> equal(1, run.rc, "an untracked long line fails the check: {run.out}")
    t |> success(find(run.out, "long.das:2:") >= 0, "the untracked file's line is named: {run.out}")
    t |> success(find(run.out, "skip.das") < 0, "an ignored file is not read: {run.out}")
}

[test]
def test_base_option_reaches_git(t : T?) {
    let cmd = "{get_das_exe()} utils/internal/line-length/main.das -- --base no-such-ref-xyz 2>&1"
    var out : string
    unsafe(popen_timeout(cmd, 120.0) $(f) {
        if (f != null) {
            out = fread(f)
        }
    })
    t |> success(find(out, "merge-base no-such-ref-xyz HEAD") >= 0,
        "--base reaches git as given, not under origin/: {out}")
}

[test]
def test_added_lines(t : T?) {
    let diff = ("diff --git a/x.das b/x.das\n--- a/x.das\n+++ b/x.das\n"
        + "@@ -3,0 +4,2 @@\n+a\n+b\n@@ -9 +11 @@\n-c\n+d\n@@ -20,2 +22,0 @@\n"
        + "diff --git a/gone.das b/gone.das\n--- a/gone.das\n+++ /dev/null\n@@ -1 +0,0 @@\n")
    let got <- added_lines(diff)
    t |> equal(length(got), 1)
    get(got, "x.das") $(lines) {
        t |> equal(lines, [4, 5, 11])
    }
}
