options gen2
options indenting = 4

module line_length shared public

require strings
require daslib/strings_boost
require daslib/lint_config public
require ../../common/text_lines.das

//! The repo defaults are `LineLengthPolicy`'s field defaults; named
//! here for the summary line and the tests
let CODE_LIMIT = LineLengthPolicy().code
let COMMENT_LIMIT = LineLengthPolicy().comment
let TAB_WIDTH = 4

struct Finding {
    line : int
    message : string
}

let private GENERATED_MARKERS = fixed_array(
    "auto-generated", "autogenerated", "automatically generated", "generated by", "do not edit")

let private GENERATED_HEADER_LINES = 10

//! The diff's base: ``base`` as given, else ``origin/<base_ref>``
def diff_base(base, base_ref : string) : string => empty(base) ? "origin/{base_ref}" : base

def is_checked(path : string) : bool => ends_with(path, ".das")

def is_generated(text : string) : bool {
    var header = 0
    for (line in split(text, "\n")) {
        break if (header >= GENERATED_HEADER_LINES)
        header++
        let low = to_lower(line)
        for (marker in GENERATED_MARKERS) {
            return true if (find(low, marker) >= 0)
        }
    }
    return false
}

def display_width(s : string) : int {
    var width = 0
    peek_data(s) $(d) {
        for (b in d) {
            if (int(b) == '\t') {
                width += TAB_WIDTH
            } elif ((int(b) & 0xC0) != 0x80) {
                width++
            }
        }
    }
    return width
}

enum private Ctx {
    str
    interp
    comment
}

struct private Frame {
    kind : Ctx
    close : string
    depth : int
}

struct private LexState {
    stack : array<Frame>
    cols : table<int; int>
    line : int
    line_start : int
}

def private mark(var s : LexState; pos : int) {
    if (!key_exists(s.cols, s.line)) {
        s.cols |> insert(s.line, pos - s.line_start)
    }
}

def private top_kind(s : LexState) : Ctx => (empty(s.stack) ? Ctx.interp
    : s.stack[length(s.stack) - 1].kind)

def private skip_line(d : array<uint8> const implicit; i : int) : int {
    var j = i
    while (j < length(d) && int(d[j]) != '\n') {
        j++
    }
    return j
}

def private is_blank(b : int) : bool => b == ' ' || b == '\t' || b == '\r'

def private on_newline(var s : LexState; d : array<uint8> const implicit; i : int) : int {
    s.line++
    let next = i + 1
    s.line_start = next
    if (top_kind(s) == Ctx.comment) {
        var k = next
        while (k < length(d) && is_blank(int(d[k]))) {
            k++
        }
        if (k < length(d) && int(d[k]) != '\n') {
            s |> mark(k)
        }
    }
    return next
}

def private step_comment(var s : LexState; d : array<uint8> const implicit; i : int) : int {
    if (starts_with(d, i, "/*")) {
        s.stack |> push(Frame(kind = Ctx.comment))
        return i + 2
    }
    if (starts_with(d, i, "*/")) {
        s.stack |> pop
        return i + 2
    }
    return i + 1
}

def private step_string(var s : LexState; d : array<uint8> const implicit; i : int) : int {
    let c = int(d[i])
    if (c == '\\') {
        return (i + 1 < length(d) && int(d[i + 1]) == '\n') ? i + 1 : i + 2
    }
    let close = s.stack[length(s.stack) - 1].close
    if (starts_with(d, i, close)) {
        s.stack |> pop
        return i + length(close)
    }
    if (c == '{') {
        s.stack |> push(Frame(kind = Ctx.interp))
    }
    return i + 1
}

def private step_code(var s : LexState; d : array<uint8> const implicit; i : int) : int {
    let c = int(d[i])
    if (!empty(s.stack)) {
        let top = length(s.stack) - 1
        if (c == '{') {
            s.stack[top].depth++
        } elif (c == '}') {
            if (s.stack[top].depth == 0) {
                s.stack |> pop
            } else {
                s.stack[top].depth--
            }
            return i + 1
        }
    }
    if (starts_with(d, i, "//")) {
        s |> mark(i)
        return skip_line(d, i)
    }
    if (starts_with(d, i, "/*")) {
        s |> mark(i)
        s.stack |> push(Frame(kind = Ctx.comment))
        return i + 2
    }
    if (c == '"' || c == '\'') {
        s.stack |> push(Frame(kind = Ctx.str, close = c == '"' ? "\"" : "'"))
    }
    return i + 1
}

def private scan_comments(d : array<uint8> const implicit) : table<int; int> {
    var s : LexState
    var i = 0
    while (i < length(d)) {
        if (int(d[i]) == '\n') {
            i = on_newline(s, d, i)
            continue
        }
        let kind = top_kind(s)
        if (empty(s.stack) || kind == Ctx.interp) {
            i = step_code(s, d, i)
        } elif (kind == Ctx.comment) {
            i = step_comment(s, d, i)
        } else {
            i = step_string(s, d, i)
        }
    }
    return <- s.cols
}

//! Maps a 0-based line index to the byte column where a comment starts on that line.
def comment_columns(text : string) : table<int; int> {
    var cols : table<int; int>
    peek_data(text) $(d) {
        cols <- scan_comments(d) // nolint:PERF030 - empty; view fills once
    }
    return <- cols
}

//! The findings over ``added`` under the limits ``pol`` carries; a limit of 0 measures nothing
def find_violations(path, text : string; added : array<int>;
                    pol : LineLengthPolicy) : array<Finding> {
    var found : array<Finding>
    if (!is_checked(path) || is_generated(text) || (pol.code <= 0 && pol.comment <= 0)) {
        return <- found
    }
    let lines <- split(text, "\n")
    let cols <- comment_columns(text)
    for (ln in added) {
        continue if (ln < 1 || ln > length(lines))
        let raw = rtrim(lines[ln - 1])
        let width = display_width(raw)
        if (pol.code > 0 && width > pol.code) {
            let message = "line is {width} columns, limit {pol.code}"
            found |> push(Finding(line = ln, message = message))
            continue
        }
        continue if (pol.comment <= 0)
        let col = cols?[ln - 1] ?? -1
        continue if (col < 0)
        let comment = display_width(slice(raw, col))
        if (comment > pol.comment) {
            let message = "comment is {comment} columns, limit {pol.comment}"
            found |> push(Finding(line = ln, message = message))
        }
    }
    return <- found
}

//! The findings under the repo defaults
def find_violations(path, text : string; added : array<int>) : array<Finding>
    => <- find_violations(path, text, added, LineLengthPolicy())

def untracked_paths(ls_files_out : string) : array<string> => <- [
    for (path in non_empty_lines(ls_files_out)); path; where is_checked(path)]

def all_lines(text : string) : array<int> => <- [
    for (k in range(1, count(text, "\n") + 2)); k]

//! Reads `git diff -U0` output: the new-side line numbers each file's hunks add.
def added_lines(diff : string) : table<string; array<int>> {
    var result : table<string; array<int>>
    var path = ""
    for (line in split(diff, "\n")) {
        if (starts_with(line, "+++ ")) {
            path = starts_with(line, "+++ b/") ? slice(line, 6) : ""
            continue
        }
        continue if (empty(path) || !starts_with(line, "@@ "))
        let plus = find(line, " +")
        continue if (plus < 0)
        let rest = slice(line, plus + 2)
        let spec = slice(rest, 0, find(rest, " "))
        let comma = find(spec, ",")
        let start = to_int(comma < 0 ? spec : slice(spec, 0, comma))
        let count = comma < 0 ? 1 : to_int(slice(spec, comma + 1))
        result[path] |> push_from([for (k in range(start, start + count)); k])
    }
    return <- result
}
