options gen2

require daslib/daspkg

[export]
def package() {
    package_name("dasllama-server")
    package_description("OpenAI-compatible HTTP server over dasLLAMA")
}

[export]
def release() {
    release_main("main.das")
    release_name("dasllama-server")
    release_include_tool("watchdog")
    release_launcher("watchdog")   // the macOS .app opens the supervisor, which starts the server
    release_program("dasllama-bench", "../../modules/dasLLAMA/benchmarks/lcpp_bench.das")   // the llama-bench rows from a shell, baked under the server's class
    release_program("dasllama-cli", "cli.das")   // the shell front end: complete / chat / transcribe / speak / talk / embed / tokenize / bench
    release_include("watchdog.json")
    release_include("control.html")
    release_include("tray.ico")   // the forge dasllama mark, served as the control page's favicon
    // licenses/: every notice the SDK installs at its doc root for what the bundle carries - the
    // runtime and every module the baked programs require - under the SDK's names; REVIEW.das
    // reads the list off the CMake install rules and refuses a missing or an unbacked row
    release_include_from("LICENSE", "licenses/LICENSE")
    release_include_from("THIRD_PARTY_NOTICES.md", "licenses/THIRD_PARTY_NOTICES.md")
    release_include_from("3rdparty/uriparser/COPYING", "licenses/URIPARSER.LICENSE")
    release_include_from("include/dag_noise/LICENSE", "licenses/DAG_NOISE.LICENSE")
    release_include_from("include/vecmath/LICENSE", "licenses/VEC_MATH.LICENSE")
    release_include_from("3rdparty/fmt/LICENSE", "licenses/FMT.LICENSE")
    release_include_from("include/fast_float/LICENSE", "licenses/FAST_FLOAT.LICENSE")
    release_include_from("src/misc/LUAU.LICENSE", "licenses/LUAU.LICENSE")
    release_include_from("modules/dasHV/HV.LICENSE", "licenses/HV.LICENSE")
    release_include_from("modules/dasHV/OPENSSL.LICENSE", "licenses/OPENSSL.LICENSE")
    release_include_from("modules/dasAudio/LICENSE.MINIAUDIO", "licenses/MINIAUDIO.LICENSE")
    release_include_from("modules/dasAudio/LICENSE.OPENMPT", "licenses/OPENMPT.LICENSE")
    release_include_from("modules/dasAudio/cipic-hrtf/CIPIC.LICENSE", "licenses/CIPIC.LICENSE")
    release_include_from("modules/dasStbImage/STB.LICENSE", "licenses/STB.LICENSE")
    release_include_from("modules/dasStbImage/fonts/droidsansmono.LICENSE", "licenses/DROID_SANS_MONO.LICENSE")
    release_include_from("modules/dasVulkan/vendor/Vulkan-Headers/LICENSE.md", "licenses/VULKAN_HEADERS.LICENSE")
    release_include_from("modules/dasVulkan/vendor/volk/LICENSE.md", "licenses/VOLK.LICENSE")
    release_include_from("modules/dasSpirv/SPIRV_HEADERS.LICENSE", "licenses/SPIRV_HEADERS.LICENSE")
    release_include_from("modules/dasLLVM/LICENSE.TXT", "licenses/LLVM.LICENSE")
    release_include_from("modules/dasLLAMA/THIRD_PARTY_NOTICES.md", "licenses/DASLLAMA_THIRD_PARTY_NOTICES.md")
    release_include_from("modules/dasLLAMA/LICENSE.LLAMA_CPP", "licenses/LLAMA_CPP.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.PARAKEET", "licenses/PARAKEET.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.VLLM", "licenses/VLLM.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.MLX", "licenses/MLX.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.SILERO", "licenses/SILERO.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.APACHE-2.0", "licenses/APACHE-2.0.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.STYLETTS2", "licenses/STYLETTS2.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.POCKET_TTS", "licenses/POCKET_TTS.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.CMUDICT", "licenses/CMUDICT.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.SPACY", "licenses/SPACY.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.UD_EWT", "licenses/UD_EWT.LICENSE")
    release_include_from("modules/dasLLAMA/LICENSE.CC-BY-4.0", "licenses/CC-BY-4.0.LICENSE")
}
