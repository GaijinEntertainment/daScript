# Repo lint policy - layered over the in-code defaults by daslib/lint_config.das
# (rules stay ON for SDK users; directives here bind this repo only).

[paths]
# Findings in these paths are dropped at report time (files still COMPILE through lint,
# so their instantiations keep the generic-exposure and nolint-consumption ledgers whole).
# This is a RATCHET: as tests/ subtrees reach zero findings, narrow or remove entries.
# The CLI escape --lint-excluded-paths shows what the policy is hiding; the MCP lint
# tool always shows raw findings (same deliberate split as --lint-fixtures).
exclude = ["tests/**"]

[rules]
# PERF031 (slice/chop on a loop-invariant string in a loop) is ON here as everywhere -
# the byte-view sweep rewrote the tree onto peek_data views; only external checkouts
# living inside the tree (dasVulkan, sfx_lab's dasImgui copies, das-claude) still hit.
PERF031 = true
